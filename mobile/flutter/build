#!/usr/bin/env bash
# 构建校验 HelloTime Pro · Flutter 移动端（iOS 模拟器 target）。
#
# 工程同 desktop/flutter（一码多端，代码不复制）。校验：令牌 codegen + analyze + build ios --simulator。
# 注：产物写入 desktop/flutter/build/，本目录不产出 build/ 目录，故脚本名可用 build
#     （桌面端因产物与脚本同名冲突才用 build.sh，见 CLAUDE.md）。
# Android：本机暂无 Android SDK，`flutter build apk` 待 SDK 安装后启用。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT="$HERE/../../desktop/flutter"
cd "$PROJECT"

export PATH="$HOME/development/flutter/bin:$PATH"
export LANG="${LANG:-en_US.UTF-8}"

if ! command -v flutter >/dev/null 2>&1; then
  echo "需要 Flutter SDK（~/development/flutter/bin 不在 PATH）。" >&2
  exit 1
fi

echo "==> 令牌 codegen"
node ../../scripts/gen-tokens-flutter

echo "==> flutter pub get"
flutter pub get

echo "==> flutter analyze"
flutter analyze

echo "==> flutter build ios --debug --simulator --no-codesign"
flutter build ios --debug --simulator --no-codesign

echo "✅ Flutter 移动端（iOS）构建校验通过；Android 待 Android SDK（flutter build apk）"
