<view class="app-root theme-{{themeMode}}">
  <view class="container stack gap-5">
    <text class="t-signal" bindtap="goBack">‹ 返回</text>
    <text class="t-2xl t-bold display">账号设置</text>

    <!-- 基本信息 -->
    <view class="card stack gap-4">
      <text class="t-lg t-semibold display">基本信息</text>
      <view class="field">
        <text class="label">邮箱</text>
        <input class="input" value="{{user.email}}" disabled />
        <text class="hint">邮箱作为登录账号不可修改。</text>
      </view>
      <view class="field">
        <text class="label">昵称</text>
        <input class="input" maxlength="20" value="{{nickname}}" bindinput="onNickname" />
      </view>
      <view class="field">
        <text class="label">头像</text>
        <view class="avatar-grid">
          <view
            wx:for="{{avatars}}"
            wx:key="id"
            class="avatar-cell {{avatarId === item.id ? 'avatar-cell-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="pickAvatar"
          >
            <avatar-badge name="{{item.name}}" avatarId="{{item.id}}" color="{{item.primaryColor}}" size="44" />
            <text class="avatar-name">{{item.name}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{profileMsg}}" class="{{profileMsg.cls}}">{{profileMsg.text}}</view>
      <view class="row gap-3" style="justify-content:flex-end">
        <view class="btn btn-ghost btn-sm" bindtap="resetProfile">重置</view>
        <view class="btn btn-primary btn-sm" bindtap="saveProfile">{{profileBusy ? '保存中…' : '保存更改'}}</view>
      </view>
    </view>

    <!-- 修改密码 -->
    <view class="card stack gap-4">
      <text class="t-lg t-semibold display">修改密码</text>
      <view class="field">
        <text class="label">当前密码</text>
        <input class="input" password value="{{oldPwd}}" bindinput="onOldPwd" />
      </view>
      <view class="field">
        <text class="label">新密码</text>
        <input class="input" password value="{{newPwd}}" bindinput="onNewPwd" />
        <text class="hint">至少 8 位且需含字母和数字；保存后所有 refresh token 会被吊销。</text>
      </view>
      <view class="field">
        <text class="label">确认新密码</text>
        <input class="input" password value="{{confirmPwd}}" bindinput="onConfirmPwd" />
      </view>
      <view wx:if="{{pwdMsg}}" class="{{pwdMsg.cls}}">{{pwdMsg.text}}</view>
      <view class="row" style="justify-content:flex-end">
        <view class="btn btn-primary btn-sm" bindtap="changePassword">{{pwdBusy ? '更新中…' : '更新密码'}}</view>
      </view>
    </view>
  </view>
</view>
