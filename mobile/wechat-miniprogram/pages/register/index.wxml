<view class="app-root theme-{{themeMode}}">
  <view class="container stack gap-5">
    <view class="row" style="justify-content:flex-end">
      <text class="t-muted" style="font-size:22px" bindtap="close">✕</text>
    </view>

    <view class="card stack gap-4">
      <view class="stack gap-1">
        <text class="t-2xl t-bold display">注册新身份</text>
        <text class="t-secondary t-sm">选一个赛博头像、写一封最早 60 秒后才能打开的信。</text>
      </view>

      <view class="field">
        <text class="label">邮箱</text>
        <input class="input" type="text" value="{{email}}" bindinput="onEmail" placeholder="you@example.com" placeholder-class="hint" />
      </view>
      <view class="field">
        <text class="label">昵称</text>
        <input class="input" maxlength="20" value="{{nickname}}" bindinput="onNickname" placeholder="2–20 字符" placeholder-class="hint" />
        <text class="hint">2–20 字符，注册后可修改。</text>
      </view>
      <view class="field">
        <text class="label">密码</text>
        <input class="input" password value="{{password}}" bindinput="onPassword" placeholder="至少 8 位" placeholder-class="hint" />
        <text class="hint">至少 8 位，需包含字母和数字。</text>
      </view>

      <view class="field">
        <text class="label">选择头像（必选）</text>
        <view class="avatar-grid">
          <view
            wx:for="{{avatars}}"
            wx:key="id"
            class="avatar-cell {{avatarId === item.id ? 'avatar-cell-on' : ''}}"
            data-id="{{item.id}}"
            bindtap="pickAvatar"
          >
            <avatar-badge name="{{item.name}}" avatarId="{{item.id}}" color="{{item.primaryColor}}" size="44" />
            <text class="avatar-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="btn btn-primary" bindtap="submit" style="height:52px;line-height:52px">{{busy ? '提交中…' : '创建账号并进入创建胶囊'}}</view>

      <view class="center" bindtap="goLogin">
        <text class="t-muted t-sm">已有账号？</text><text class="t-signal t-sm">去登录</text>
      </view>
    </view>

    <view wx:if="{{err}}" class="error-box">{{err}}</view>
  </view>
</view>
