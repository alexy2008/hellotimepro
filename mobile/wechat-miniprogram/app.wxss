/* ============================================================
   全局样式：引入 codegen 令牌（tokens.wxss）+ 一套共享类。
   所有颜色/间距/圆角走 var(--…)，随 .theme-dark / .theme-light 切换
   （根节点 class="app-root theme-{{themeMode}}"）。
   ============================================================ */
@import "./tokens/tokens.wxss";

page {
  background: #06060c;
}

.app-root {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--surface-0);
  color: var(--text-primary);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-base);
  line-height: 1.5;
}

/* ---- 布局 ---- */
.container {
  padding: var(--space-4);
  padding-bottom: 96px;
}
.stack { display: flex; flex-direction: column; }
.row { display: flex; flex-direction: row; align-items: center; }
.gap-1 { gap: var(--space-1); }
.gap-2 { gap: var(--space-2); }
.gap-3 { gap: var(--space-3); }
.gap-4 { gap: var(--space-4); }
.flex-1 { flex: 1; }
.center { text-align: center; }
.wrap { flex-wrap: wrap; }
.between { justify-content: space-between; }

/* ---- 文本 ---- */
.t-primary { color: var(--text-primary); }
.t-secondary { color: var(--text-secondary); }
.t-muted { color: var(--text-muted); }
.t-accent { color: var(--accent-primary); }
.t-signal { color: var(--signal-primary); }
.t-danger { color: var(--danger-fg); }
.t-xs { font-size: var(--font-xs); }
.t-sm { font-size: var(--font-sm); }
.t-lg { font-size: var(--font-lg); }
.t-xl { font-size: var(--font-xl); }
.t-2xl { font-size: var(--font-2xl); }
.t-bold { font-weight: 700; }
.t-semibold { font-weight: 600; }
.display {
  font-weight: 700;
  letter-spacing: 0.5px;
}

/* ---- 顶部标题栏（页面内 hero header） ---- */
.screen-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-4) 0;
}
.screen-title {
  font-size: var(--font-xl);
  font-weight: 700;
}

/* ---- 卡片 ---- */
.card {
  background: var(--surface-1);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  padding: var(--space-4);
}
.card-hero {
  background: var(--surface-1);
  border: 1px solid var(--plaza-card-border);
  border-radius: var(--radius-2xl);
  padding: var(--space-5);
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
  padding: 0 var(--space-4);
  height: 44px;
  font-size: var(--font-base);
  font-weight: 600;
  line-height: 44px;
  border: 1px solid transparent;
}
.btn::after { border: none; }
.btn-primary { background: var(--brand-primary); color: var(--brand-on); }
.btn-accent { background: var(--accent-primary); color: var(--accent-on); }
.btn-success { background: var(--success-solid); color: var(--success-on); }
.btn-outline {
  background: transparent;
  color: var(--text-primary);
  border: 1px solid var(--border-default);
}
.btn-ghost { background: transparent; color: var(--text-link); }
.btn-danger { background: var(--danger-bg); color: var(--danger-fg); border: 1px solid var(--danger-border); }
.btn-sm { height: 34px; line-height: 34px; font-size: var(--font-sm); padding: 0 var(--space-3); }
.btn[disabled] { opacity: 0.5; }

/* ---- 分段选择 / chip ---- */
.seg { display: flex; flex-direction: row; gap: var(--space-1); }
.chip {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: var(--surface-2);
  color: var(--text-secondary);
  font-size: var(--font-sm);
  border: 1px solid var(--border-subtle);
}
.chip-active {
  background: var(--brand-subtle);
  color: var(--text-primary);
  border-color: var(--brand-primary);
}

/* ---- 表单 ---- */
.field { display: flex; flex-direction: column; gap: var(--space-2); }
.label { font-size: var(--font-sm); color: var(--text-secondary); }
.input, .textarea {
  background: var(--surface-2);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  color: var(--text-primary);
  font-size: var(--font-base);
}
.textarea { width: 100%; box-sizing: border-box; min-height: 120px; }

/* ---- 徽标 / 状态标签 ---- */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 600;
}
.badge-sealed { background: var(--capsule-sealed-subtle, var(--signal-subtle)); color: var(--capsule-sealed-accent); border: 1px solid var(--capsule-sealed-border); }
.badge-opened { background: var(--capsule-opened-subtle); color: var(--capsule-opened-accent); border: 1px solid var(--capsule-opened-border); }

/* ---- 分隔 / 提示 ---- */
.divider { height: 1px; background: var(--plaza-divider); margin: var(--space-3) 0; }
.hint { color: var(--text-muted); font-size: var(--font-sm); }
.error-box {
  background: var(--danger-bg);
  color: var(--danger-fg);
  border: 1px solid var(--danger-border);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  font-size: var(--font-sm);
}

/* ---- 空态 ---- */
.empty { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); padding: var(--space-12) var(--space-4); }
.empty-emoji { font-size: 40px; }

/* ---- 加载 ---- */
.loading { padding: var(--space-8); text-align: center; color: var(--text-muted); }
