.cc-card {
  background: var(--plaza-card-bg);
  border: 1px solid var(--plaza-card-border);
  border-radius: var(--radius-xl);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.cc-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-2);
}
.cc-creator { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.cc-nick { color: var(--text-secondary); font-size: var(--font-sm); font-weight: 600; }
.cc-code { color: var(--text-muted); font-size: var(--font-xs); }
.cc-title {
  color: var(--text-primary);
  font-size: var(--font-lg);
  font-weight: 700;
  line-height: 1.35;
}
.cc-preview {
  color: var(--text-muted);
  font-size: var(--font-sm);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cc-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}
.cc-count { color: var(--signal-primary); font-size: var(--font-sm); }
.cc-fav {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  background: var(--surface-2);
  color: var(--favorite-inactive);
}
.cc-fav-on { color: var(--favorite-active); }
.cc-heart { font-size: var(--font-lg); }
.cc-favnum { font-size: var(--font-sm); }
.cc-del {
  padding: 4px 12px;
  border-radius: var(--radius-full);
  background: var(--danger-bg);
  color: var(--danger-fg);
  font-size: var(--font-sm);
}
