<view class="avatar-badge" style="width:{{size}}px;height:{{size}}px">
  <image
    wx:if="{{imgOk && imgSrc}}"
    class="avatar-img"
    style="width:{{size}}px;height:{{size}}px"
    src="{{imgSrc}}"
    mode="aspectFill"
    binderror="onImgError"
  />
  <view
    wx:else
    class="avatar-fallback"
    style="width:{{size}}px;height:{{size}}px;background:{{bg}};font-size:{{fontSize}}px"
  >{{ch}}</view>
</view>
