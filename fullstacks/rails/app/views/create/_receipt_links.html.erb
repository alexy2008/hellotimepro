<%= link_to capsule_path(capsule[:code]), data: { view_testid: "receipt-view" }, class: ("link-btn" if skin == "amber") do %>
  查看这枚胶囊 <%= icon "arrow" %>
<% end %>
<% if action_name == "create" && request.format.html? %>
  <%= button_to create_path, method: :get, class: "btn btn--ghost", data: { view_testid: "receipt-again" } do %>
    再写一枚 <%= icon(skin == "paper" ? "pen" : "plus") %>
  <% end %>
<% else %>
  <button class="<%= skin == "paper" ? "linkbtn" : "link-btn" %>" type="button" data-view-testid="receipt-again" data-create-again>
    再写一枚 <%= icon(skin == "paper" ? "pen" : "plus") %>
  </button>
<% end %>
<% if skin == "amber" %><%= link_to me_created_path, class: "link-btn" do %>我创建的 <%= icon "feather" %><% end %><% end %>
