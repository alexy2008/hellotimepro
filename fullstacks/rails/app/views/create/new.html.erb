<div class="page page--create" data-controller="create" data-create-owner-value="<%= current_user.id %>"
     data-action="hellotime:skin@document->create#switchSkin time-picker:picked->create#pickTime">
  <%= form_with url: create_path, html: { novalidate: true },
                data: { create_target: "form editor", turbo: false, action: "submit->create#submit input->create#edit compositionend->create#edit" } do %>
    <% initial_time = @initial_time %>
    <%= hidden_field_tag :openAt, initial_time, data: { create_target: "time" } %>
    <% %w[paper amber].each do |skin| %>
      <fieldset class="create-view" data-skin-only="<%= skin %>" data-create-target="view" <%= "disabled" if skin == "amber" %>>
        <%= render "skins/#{skin}/create", initial_time: initial_time %>
      </fieldset>
    <% end %>
  <% end %>
  <div id="creation-receipt" data-create-target="receipt" data-action="click->create#receiptAction"></div>
</div>
