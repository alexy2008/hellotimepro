<header class="me__head card">
  <div class="me__id">
    <span data-skin-only="paper"><%= render "skins/paper/avatar_stamp", id: current_user.avatar_id, css: "stamp--lg" %></span>
    <div class="me__orb" data-skin-only="amber"><%= avatar current_user.avatar_id, "av--hero" %><span class="me__ring"></span></div>
    <div>
      <div class="overline" data-skin-only="paper"><i></i>My desk</div><div class="eyebrow" data-skin-only="amber">My capsules</div>
      <h1 class="h1 page-title"><%= current_user.nickname %></h1>
      <p class="me__mail"><span class="mono"><%= current_user.email %></span><span><%= current_user.created_at.strftime("%Y年%m月%d日") %> 加入</span></p>
    </div>
  </div>
  <dl class="me__stats">
    <% [["created", "写下的胶囊", nil], ["unopened", "还在等待启封", "还在封存中"], ["favoritesReceived", "被收藏的次数", nil]].each do |key, paper, amber| %>
      <div data-testid="me-stat" data-key="<%= key %>" data-value="<%= @stats[key.to_sym] %>">
        <dd class="latin" data-skin-only="paper"><%= @stats[key.to_sym] %></dd><dd class="mono" data-skin-only="amber"><%= @stats[key.to_sym] %></dd>
        <dt><% if amber %><span data-skin-only="paper"><%= paper %></span><span data-skin-only="amber"><%= amber %></span><% else %><%= paper %><% end %></dt>
      </div>
    <% end %>
  </dl>
</header>
<nav class="me__tabs tabs" data-skin-only="paper" aria-label="我的">
  <%= render "me/tab_links", css: "tabs__it" %>
  <span class="tabs__ink" aria-hidden="true"></span>
  <%= form_with url: logout_path, class: "tabs__out" do %>
    <button class="linkbtn" type="submit"><%= icon "logout" %>登出</button>
  <% end %>
</nav>
<div class="me__tabs me__bar" data-skin-only="amber">
  <nav class="seg seg--lg" aria-label="我的">
    <span class="seg__thumb" aria-hidden="true"></span>
    <%= render "me/tab_links", css: "seg__opt" %>
  </nav>
  <%= form_with url: logout_path do %>
    <button class="btn btn--ghost btn--sm" type="submit"><%= icon "logout" %>登出</button>
  <% end %>
</div>
