<% content_for :title, "我创建的胶囊" %>

<main class="cy-container">
  <div class="cy-me">
    <%= render "me/me_nav", active: "created" %>
    <section class="cy-me__content">
      <h1>我创建的胶囊</h1>

      <div class="cy-toolbar" style="border-bottom:none;padding-top:0">
        <span style="color:var(--color-text-muted);font-size:var(--font-size-sm)">按创建时间倒序 · 共 <%= @pagination[:total] %> 条</span>
        <a class="cy-btn cy-btn--primary cy-btn--sm" href="/create">+ 新建胶囊</a>
      </div>

      <% if @items.empty? %>
        <div class="cy-empty">
          <div class="cy-empty__emoji">📭</div>
          <p>还没有创建任何胶囊</p>
          <a class="cy-btn cy-btn--primary cy-btn--sm" href="/create" style="margin-top:var(--space-3)">去创建一个</a>
        </div>
      <% else %>
        <div class="cy-grid">
          <% @items.each do |cap| %>
            <%= render "public/capsule_card", capsule: cap, show_creator: false, hide_favorite: true, authenticated: true %>
          <% end %>
        </div>
        <%= render "shared/pagination",
              pagination: @pagination,
              path: "/me/created",
              params_for_page: {} %>
      <% end %>
    </section>
  </div>
</main>
