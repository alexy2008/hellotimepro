<div class="page page--me">
  <div class="wrap container me">
    <%= render "me/overview" %>
    <div class="me__body is-swap profile">
      <section class="pane card card--pad">
        <div class="eyebrow" data-skin-only="amber">Profile</div>
        <h2 class="pane__h card__title">基本信息</h2>
        <%= form_with url: me_profile_path, method: :patch, html: { novalidate: true },
                      data: { controller: "account-form avatar-picker", initial_nickname: @user.nickname,
                              avatar_picker_initial_value: @user.avatar_id, action: "submit->account-form#validateNickname" } do %>
          <%= render "shared/account_field", label: "邮箱", name: "email", type: "email", testid: "profile-email",
                     value: @user.email, disabled: true, hint: "邮箱是登录账号，不可修改。" %>
          <%= render "shared/account_field", label: "昵称", name: "nickname", autocomplete: "nickname", testid: "profile-nickname",
                     value: @profile_error ? params[:nickname] : @user.nickname, taken: @nickname_taken, hint: "2–20 个字符，全站唯一。" %>
          <div class="field field--plain">
            <span class="field__label">头像</span><%= render "shared/avatar_picker", selected: @profile_error ? params[:avatarId] : @user.avatar_id, nested: false %>
          </div>
          <% if @profile_error %><div class="form__err" role="alert"><%= @profile_error %></div><% end %>
          <div class="pane__act card__act">
            <button class="btn btn--ghost" type="button" data-action="account-form#resetProfile avatar-picker#reset">重置</button>
            <button class="btn btn--primary" type="submit" data-testid="profile-save">保存更改</button>
          </div>
        <% end %>
      </section>
      <section class="pane card card--pad">
        <div class="eyebrow" data-skin-only="amber">Security</div>
        <h2 class="pane__h card__title">修改密码</h2>
        <%= form_with url: profile_password_path, html: { novalidate: true },
                      data: { controller: "account-form",
                              action: "submit->account-form#validatePassword input->account-form#clearPasswordError" } do %>
          <%= render "shared/account_field", label: "当前密码", name: "currentPassword", type: "password", autocomplete: "current-password", testid: "pwd-current" %>
          <%= render "shared/account_field", label: "新密码", name: "newPassword", type: "password", autocomplete: "new-password", testid: "pwd-new" %>
          <%= render "shared/password_rules" %>
          <%= render "shared/account_field", label: "再输一次新密码", name: "confirmPassword", type: "password", autocomplete: "new-password", testid: "pwd-confirm" %>
          <div class="field__hint form__err" role="alert" data-field="confirm" data-account-form-target="error"
               <%= @confirm_error ? 'data-testid=field-error' : 'hidden' %>>两次输入的新密码不一致</div>
          <% if @password_error %><div class="form__err" role="alert"><%= @password_error %></div><% end %>
          <p class="pane__fine tip tip--quiet"><%= icon "shield" %><span>更新密码后需要重新登录。</span></p>
          <div class="pane__act card__act"><button class="btn btn--primary" type="submit" data-testid="pwd-submit">更新密码</button></div>
        <% end %>
      </section>
    </div>
  </div>
</div>
