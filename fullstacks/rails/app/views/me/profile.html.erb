<% content_for :title, "账号设置" %>

<main class="cy-container">
  <div class="cy-me">
    <%= render "me/me_nav", active: "profile" %>
    <section class="cy-me__content" data-controller="profile">
      <h1>账号设置</h1>

      <%# 基本信息 %>
      <div class="cy-card" style="margin-bottom:var(--space-6)">
        <h2 style="font-size:var(--font-size-xl);margin:0 0 var(--space-5);font-family:var(--font-display)">基本信息</h2>
        <form id="profile-form" class="cy-form"
              data-controller="avatar-picker"
              data-action="submit->profile#save"
              data-orig-nick="<%= @user.nickname %>" data-orig-avatar="<%= @user.avatar_id %>">
          <div class="cy-field">
            <label>邮箱</label>
            <input class="cy-input" value="<%= @user.email %>" disabled>
            <span class="cy-field__hint">邮箱作为登录账号不可修改。</span>
          </div>
          <div class="cy-field">
            <label for="nick">昵称</label>
            <input class="cy-input" id="nick" maxlength="20" value="<%= @user.nickname %>" data-profile-target="nick">
          </div>
          <div class="cy-field">
            <label>头像</label>
            <div class="cy-avatar-picker" role="radiogroup" aria-label="选择头像">
              <% @avatars.each do |a| %>
                <button type="button" role="radio"
                        class="cy-avatar-picker__item <%= " is-selected" if a[:id] == @user.avatar_id %>"
                        aria-checked="<%= a[:id] == @user.avatar_id %>"
                        data-avatar-id="<%= a[:id] %>" title="<%= a[:name] %>"
                        data-avatar-picker-target="item" data-action="click->avatar-picker#select">
                  <img src="<%= avatar_url(a[:id]) %>" alt="<%= a[:name] %>">
                </button>
              <% end %>
            </div>
          </div>

          <div id="profile-msg" data-profile-target="msg"></div>

          <div style="display:flex;gap:var(--space-3);justify-content:flex-end">
            <button type="button" class="cy-btn cy-btn--ghost" data-action="click->profile#reset">重置</button>
            <button class="cy-btn cy-btn--primary" type="submit">保存更改</button>
          </div>
        </form>
      </div>

      <%# 修改密码 %>
      <div class="cy-card" style="margin-bottom:var(--space-6)">
        <h2 style="font-size:var(--font-size-xl);margin:0 0 var(--space-5);font-family:var(--font-display)">修改密码</h2>
        <form id="password-form" class="cy-form" data-action="submit->profile#changePassword">
          <div class="cy-field">
            <label for="oldPwd">当前密码</label>
            <input class="cy-input" id="oldPwd" type="password" required data-profile-target="oldPwd">
          </div>
          <div class="cy-field">
            <label for="newPwd">新密码</label>
            <input class="cy-input" id="newPwd" type="password" required minlength="8" data-profile-target="newPwd">
            <span class="cy-field__hint">至少 8 位且需含字母和数字；保存后所有 refresh token 会被吊销。</span>
          </div>
          <div class="cy-field">
            <label for="confirmPwd">确认新密码</label>
            <input class="cy-input" id="confirmPwd" type="password" required minlength="8" data-profile-target="confirmPwd">
          </div>

          <div id="password-msg" data-profile-target="pwdMsg"></div>

          <div style="display:flex;justify-content:flex-end">
            <button class="cy-btn cy-btn--primary" type="submit">更新密码</button>
          </div>
        </form>
      </div>
    </section>
  </div>
</main>
