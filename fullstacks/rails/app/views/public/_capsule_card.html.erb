<% opened = capsule[:isOpened]
   kind = opened ? "opened" : "sealed"
   progress = waiting_progress(capsule) %>
<%= tag.article class: "cap cap--#{kind} pc #{opened ? 'is-opened' : 'is-locked'}", style: "--i: #{index}; --glow: oklch(0.72 0.17 #{capsule_hue(capsule[:code])} / 0.34)",
                data: capsule_attrs(capsule).merge(testid: "capsule-card") do %>
  <div class="cap__bg" data-skin-only="paper" aria-hidden="true">
    <%= render "skins/paper/card_art", opened: opened %>
  </div>
  <div class="pc__top cap__top">
    <div class="pc__art" data-skin-only="amber"><%= render "skins/amber/capsule_art", code: capsule[:code], opened: opened, width: 150 %></div>
    <span class="seal seal--<%= opened ? "line" : "solid" %>" data-skin-only="paper"><%= opened ? "启" : "封" %></span>
    <div class="pc__badges">
      <span class="cap__status badge badge--<%= opened ? "opened" : "locked" %>"><%= opened ? "已开启" : "封存中" %></span>
      <% if rank %><span class="cap__rank badge badge--hot latin">No.<%= rank %></span><% end %>
    </div>
    <span class="cap__code mono" data-skin-only="paper"><%= capsule[:code] %></span>
  </div>
  <%= link_to "", capsule_path(capsule[:code]), class: "cap__link pc__link", aria: { label: capsule[:title] }, data: { testid: "card-open" } %>
  <h3 class="cap__title pc__title" data-testid="card-title"><%= capsule[:title] %></h3>
  <div class="pc__body">
    <% if opened %>
      <p class="cap__preview pc__excerpt"><%= capsule[:contentPreview] %></p>
    <% else %>
      <div class="cap__veil" data-skin-only="paper" aria-hidden="true"><i></i><i></i></div>
      <div class="cap__cd pc__cd"><span class="cap__cd-label" data-skin-only="paper">距启封</span>
        <%= render "shared/compact_countdown", open_at: capsule[:openAt] %><span data-skin-only="amber">后开启</span>
      </div>
      <div class="pc__progress waiting-progress" aria-label="时间进度 <%= progress %>%"><span style="width: <%= progress %>%"></span></div>
    <% end %>
  </div>
  <div class="cap__foot pc__foot">
    <span class="cap__by pc__by"><%= avatar capsule[:creator][:avatarId] %><b class="pc__name"><%= capsule[:creator][:nickname] %></b></span>
    <time class="pc__when mono" datetime="<%= capsule[:openAt] %>" data-controller="local-time"><%= fmt_date(capsule[:openAt]) %></time>
    <%= render "public/favorite_button", capsule: capsule %>
  </div>
<% end %>
