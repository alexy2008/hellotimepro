<% item_hook = local_assigns.fetch(:item_hook, "capsule-card")
   open_hook = item_hook == "fav-item" ? "row-open" : "card-open" %>
<% %w[paper amber].each do |skin| %>
  <%= render "skins/#{skin}/card", capsule: capsule, index: index, rank: rank, item_hook: item_hook, open_hook: open_hook %>
<% end %>
