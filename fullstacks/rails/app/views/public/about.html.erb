<% features = [
          ["user", "账号与头像", "邮箱注册即登录；十个内置头像，昵称全站唯一。"],
          ["pen", "写一枚胶囊", "标题、正文、开启时间；没有头绪时，AI 给灵感，也能代笔。"],
          ["clock", "倒计时与自动开启", "没到时间只显示倒计时；归零的那一刻，胶囊自己打开。"],
          ["grid", "胶囊广场", "公开的胶囊陈列在这里，可搜索、筛选，按最新或最热排序。"],
          ["heart", "收藏与「我的」", "收藏任何一枚胶囊，等它开启；在「我的」里管理写过的每一枚。"],
          ["palette", "两套皮肤，昼夜两色", "「时笺」与「琥珀」随时切换，各有明暗两套主题，并记住你的选择。"]
        ] %>
<% tenets = [
          ["规范即唯一事实源", "业务契约放在 spec/ 下：OpenAPI、数据库 schema、设计令牌。代码只是规范的投影，有歧义先改规范。"],
          ["栈内地道", "Signals、组合式、Hooks、Runes、Compose……每个实现都用自己技术栈的惯用写法，而不是把同一份代码翻译十遍。"],
          ["外部一致", "无论内部怎么写，对外的路由、JSON 形状、错误码与界面必须一致——肉眼可比，才谈得上对比。"],
          ["黑盒验证", "契约用例与 UI 冒烟都从外部跑，不信任任何实现的自述；每个后端都要在 PostgreSQL 与 SQLite 上各过一遍。"]
        ] %>
<% health = HealthMetadata.build
   ui = interface_stack_items
   ui_summary = "基于 Action View ERB 模板与 Hotwire 构建界面层，双皮肤视图统一由服务端直出 HTML，首屏前内联脚本写入皮肤与明暗属性防止闪烁。" \
                "Turbo 2.0 通过 Drive 与 Frame 驱动无刷新页面跳转、广场局部筛选分页与表单回执更新；" \
                "Stimulus 1.3 控制器以低侵入方式管理星轨时钟、对数时间标尺、8 格输码、倒计时自动开启、换肤转场与客户端校验。" \
                "样式原样引入 spec/styles 2.0 设计令牌与自托管字体，遵循无打包的 Importmap 惯例。"
   stacks = [["界面层", "Interface", "ERB + Hotwire", "fullstacks/rails", ui, ui_summary],
             ["服务端", "Server", "Ruby on Rails", health[:stack][:kind], health[:stack][:items], health[:stack][:summary]]]
   credits = [["code", "源码", "本实现位于仓库的 fullstacks/rails 目录。"],
              ["heart", "致谢", "技术栈图标来自 Simple Icons 与各项目官方标识；感谢每一个开源框架的作者与维护者。"],
              ["book", "许可", "MIT License。本项目用于教学、对比与研究，不面向生产环境。"]] %>
<div class="page page--about">
  <% %w[paper amber].each do |skin| %>
    <div data-skin-only="<%= skin %>">
      <%= render "skins/#{skin}/about", features: features, tenets: tenets, stacks: stacks, credits: credits %>
    </div>
  <% end %>
</div>
