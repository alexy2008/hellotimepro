<%= tag.div class: "page page--detail", data: capsule_attrs(capsule).merge(
        testid: "capsule-detail", controller: "countdown",
        countdown_created_at_value: capsule[:createdAt], countdown_open_at_value: capsule[:openAt],
        countdown_url_value: capsule_fragment_path(capsule[:code]),
        action: "hellotime:skin@document->countdown#restart turbo:before-visit@document->countdown#stop") do %>
  <% %w[paper amber].each do |skin| %>
    <div class="<%= skin == "paper" ? "wrap wrap--narrow" : "container" %> detail" data-skin-only="<%= skin %>">
      <%= render "skins/#{skin}/detail", capsule: capsule %>
    </div>
  <% end %>
<% end %>
