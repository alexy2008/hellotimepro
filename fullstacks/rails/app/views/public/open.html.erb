<div class="page page--open">
  <div class="wrap container open openp">
    <div class="openp__poem" data-skin-only="paper" aria-hidden="true"><span>云中谁寄锦书来</span><i></i><small>李清照 ·《一剪梅》</small></div>
    <section class="openp__main">
      <header data-skin-only="paper">
        <div class="overline"><i></i>Open a capsule</div>
        <h1 class="h1">凭码开启</h1>
        <p class="lede">输入朋友分享给你的 8 位胶囊码。<br>如果还没到启封的时刻，你会看到它的倒计时。</p>
      </header>
      <header class="page-head page-head--center" data-skin-only="amber">
        <div class="eyebrow">Open a capsule</div>
        <h1 class="page-title">开启胶囊</h1>
        <p class="page-lead">输入 8 位胶囊码。到了开启时间，就能读到里面的话；还没到，就陪它一起倒数。</p>
      </header>
      <form class="open__form card" action="/open" data-controller="code-input" data-code-input-autofocus-value="true"
            data-action="submit->code-input#submit turbo:before-visit@document->code-input#cancel">
        <%= render "shared/code_fields", compact: false %>
        <div class="open__err openp__err" role="alert" data-code-input-target="error"></div>
        <div class="openp__act">
          <button class="btn btn--primary btn--lg" type="submit" disabled data-code-input-target="submit"><%= icon "key" %><span data-skin-only="paper">开启</span><span data-skin-only="amber">开启胶囊</span><%= icon "arrow", "ic--go" %></button>
          <button class="btn btn--ghost btn--lg" type="button" data-skin-only="paper" data-action="code-input#paste"><%= icon "paste" %> 粘贴识别</button>
        </div>
        <p class="open__hint" data-skin-only="amber">胶囊码由 8 位大写字母与数字组成，输入时不区分大小写，可直接粘贴。<br>
          没有发布到广场的胶囊，同样可以凭码开启。也可以直接访问 <code class="mono">/capsules/胶囊码</code>。</p>
        <ul class="openp__tips" data-skin-only="paper">
          <li><%= icon "link" %><span>也可以直接访问 <code class="mono">/capsules/&lt;胶囊码&gt;</code></span></li>
          <li><%= icon "lock" %><span>没有发布到广场的胶囊，同样可以凭码开启</span></li>
        </ul>
      </form>
      <% if @recent.any? %>
        <section class="mylist open__list" data-testid="my-sealed">
          <header class="mylist__head"><h2>我封存过的胶囊</h2><%= link_to "全部 →", me_created_path, class: "link-btn" %></header>
          <ul>
            <% @recent.each do |capsule| %>
              <li><%= link_to capsule_path(capsule[:code]), class: "crow mylist__row",
                              style: "--glow: oklch(0.72 0.17 #{capsule_hue(capsule[:code])} / 0.34)",
                              data: capsule_attrs(capsule).merge(testid: "my-sealed-item") do %>
                <span data-skin-only="amber"><%= render "skins/amber/capsule_art", code: capsule[:code], opened: capsule[:isOpened], width: 72 %></span>
                <span class="seal seal--<%= capsule[:isOpened] ? "line" : "solid" %>" data-skin-only="paper"><%= capsule[:isOpened] ? "启" : "封" %></span>
                <span class="crow__info mylist__info"><b><%= capsule[:title] %></b><span class="mono"><%= capsule[:code] %></span></span>
                <% if capsule[:isOpened] %>
                  <span class="mylist__st badge badge--opened"><span data-skin-only="amber"><%= icon "mail" %></span> 已开启</span>
                <% else %>
                  <span class="mylist__st" data-skin-only="paper">距启封 <%= duration_words(Time.current.iso8601, capsule[:openAt]) %></span>
                  <span class="badge badge--locked" data-skin-only="amber"><%= icon "lock" %> <%= render "shared/compact_countdown", open_at: capsule[:openAt] %> 后</span>
                <% end %>
                <%= icon "chev-right", "crow__go" %>
              <% end %></li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </section>
  </div>
</div>
