<% if @plaza_error %>
  <%= render "public/plaza_error" %>
<% else %>
  <div class="plaza__count" data-plaza-counts data-all="<%= @stats[:counts][:all] %>"
       data-opened="<%= @stats[:counts][:opened] %>" data-unopened="<%= @stats[:counts][:unopened] %>">
    共 <b><%= @pagination[:total] %></b> 枚胶囊<%= " · 关键词「#{@q}」" if @q.present? %>
  </div>
  <div class="grid">
    <% if @items.empty? %>
      <div class="empty" data-testid="list-empty">
        <% if @q.present? %>
          <h3 class="empty__title">没有找到「<%= @q %>」</h3><p>换个关键词试试，标题和昵称都可以搜。</p>
          <button class="btn btn--ghost" type="button" data-action="plaza-search#clear">清空搜索</button>
        <% else %>
          <h3 class="empty__title">广场上还没有胶囊</h3>
          <%= create_link "写一枚胶囊" %>
        <% end %>
      </div>
    <% else %>
      <% @items.each_with_index do |capsule, index| %>
        <%= render "public/capsule_card", capsule: capsule, index: index, rank: (@sort == "hot" && @q.blank? && @filter == "all" && @page == 1 && index < 3 ? index + 1 : nil) %>
      <% end %>
    <% end %>
  </div>
  <% if @pagination[:totalPages] > 1 %>
    <nav class="pager" aria-label="广场分页">
      <button class="pager__nav pager__btn" type="button" data-action="plaza-search#page" data-page="<%= @page - 1 %>" <%= "disabled" if @page <= 1 %>>‹ 上一页</button>
      <span class="pager__sum"><%= @page %> / <%= @pagination[:totalPages] %></span>
      <button class="pager__nav pager__btn" type="button" data-action="plaza-search#page" data-page="<%= @page + 1 %>"
              <%= @page < @pagination[:totalPages] ? 'data-testid=plaza-next' : 'disabled' %>>下一页 ›</button>
    </nav>
  <% end %>
<% end %>
