<div class="copy-actions" data-controller="clipboard" data-clipboard-code-value="<%= code %>">
  <button class="btn btn--ghost" type="button" data-testid="copy-code" data-action="clipboard#copyCode"><%= icon "copy" %> 复制胶囊码</button>
  <button class="btn btn--ghost" type="button" data-testid="copy-link" data-action="clipboard#copyLink"><%= icon "link" %> 复制链接</button>
</div>
