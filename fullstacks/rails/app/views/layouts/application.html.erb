<!doctype html>
<html lang="zh-CN" data-skin="amber" data-theme="dark">
  <head>
    <title>HelloTime Pro · 把此刻寄给未来</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#080b1a">
    <meta name="turbo-cache-control" content="no-cache">
    <script>
      try {
        var root = document.documentElement;
        var skin = localStorage.getItem("hellotime.skin");
        var theme = localStorage.getItem("hellotime.theme");
        if (skin !== "paper" && skin !== "amber") skin = "amber";
        if (theme !== "dark" && theme !== "light") {
          theme = window.matchMedia && matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        root.dataset.skin = skin;
        root.dataset.theme = theme;
        var colors = { paper: { light: "#F3EFE5", dark: "#131210" }, amber: { light: "#faf5ea", dark: "#080b1a" } };
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", colors[skin][theme]);
      } catch {}
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag(*ApplicationHelper::STYLE_FILES, "data-turbo-track": "reload") %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-route="<%= route_name %>" data-controller="shell"
        data-shell-user-value="<%= current_user&.id %>"
        data-action="click@document->shell#closeOutside keydown.esc@document->shell#closeMenu scroll@window->shell#scroll">
    <%= render "skins/amber/sky" %>
    <svg width="0" height="0" class="paper-filters" aria-hidden="true">
      <filter id="f-rough"><feTurbulence baseFrequency=".07" numOctaves="2" seed="9"/>
        <feDisplacementMap in="SourceGraphic" scale="1.4"/></filter>
      <filter id="f-ink"><feTurbulence baseFrequency=".045" numOctaves="2" seed="19"/>
        <feDisplacementMap in="SourceGraphic" scale="2"/></filter>
    </svg>
    <%= render "shared/header" %>
    <main id="view"><%= yield %></main>
    <%= render "shared/footer" %>
    <%= render "shared/feedback" %>
  </body>
</html>
