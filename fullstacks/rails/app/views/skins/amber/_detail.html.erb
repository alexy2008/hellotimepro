<% code = capsule[:code]
   time_created = capsule[:createdAt]
   time_open = capsule[:openAt]
   visibility = capsule[:inPlaza] ? "广场公开" : "仅凭码可见"
   badge = capsule[:inPlaza] ? "badge--plaza" : "badge--private" %>
<%= link_to root_path, class: "back" do %><%= icon "arrow-left" %> 回到广场<% end %>
<% if capsule[:isOpened] %>
  <div class="letter-page" data-letter>
    <article class="letter">
      <div class="letter__meta"><span class="mono"><%= code %></span><i></i><span class="badge <%= badge %>"><%= visibility %></span></div>
      <h1 class="letter__title" data-view-testid="detail-title"><%= capsule[:title] %></h1>
      <div class="letter__from"><%= avatar capsule[:creator][:avatarId] %>
        <%= capsule[:creator][:nickname] %> 写于 <%= render "public/detail_time", value: time_created, precise: false %>
      </div>
      <%= render "public/letter_body", capsule: capsule %>
      <footer class="letter__foot">
        <div class="letter__span">
          <div><%= icon "hourglass" %> 这封信在时间里沉睡了 <b><%= duration_words(time_created, time_open) %></b></div>
          <span class="mono"><%= render "public/detail_time", value: time_created %> 封存 → <%= render "public/detail_time", value: time_open %> 开启</span>
        </div>
        <div class="letter__sign"><%= render "skins/amber/stamp", date: fmt_date(time_open) %><span>—— <%= capsule[:creator][:nickname] %></span></div>
      </footer>
    </article>
    <%= render "public/detail_actions", capsule: capsule, letter: true %>
    <% unless capsule[:inPlaza] %><p class="tip tip--quiet"><%= icon "lock" %> 这枚胶囊没有发布到广场，只有持有胶囊码的人能读到它。</p><% end %>
  </div>
<% else %>
  <% progress = waiting_progress(capsule) %>
  <section class="vault card" data-locked-vault style="--glow: oklch(0.72 0.17 <%= capsule_hue(code) %> / 0.34)">
    <div class="vault__dial">
      <svg class="vault__ring" viewBox="0 0 340 340" aria-hidden="true">
        <circle class="vault__track" cx="170" cy="170" r="150"/>
        <circle class="vault__arc" cx="170" cy="170" r="150" stroke-dasharray="<%= 3 * Math::PI * progress %> <%= 300 * Math::PI %>" data-journey-arc/>
      </svg>
      <div class="vault__art"><%= render "skins/amber/capsule_art", code: code, opened: false, width: 220 %></div>
      <div class="vault__pct"><b class="mono" data-journey-percent><%= format("%.2f", progress) %>%</b><span>时间已经走过</span></div>
    </div>
    <div class="vault__info">
      <div class="badges"><span class="badge badge--locked"><%= icon "lock" %> 封存中</span><span class="badge <%= badge %>"><%= visibility %></span></div>
      <h1 class="vault__title" data-view-testid="detail-title"><%= capsule[:title] %></h1>
      <div class="vault__by"><%= avatar capsule[:creator][:avatarId] %> 来自 <b><%= capsule[:creator][:nickname] %></b> · 封存于
        <%= render "public/detail_time", value: time_created, precise: false %></div>
      <div class="vault__k">距离开启还有</div>
      <div data-view-testid="countdown" data-open-at="<%= time_open %>">
        <div class="cd" role="timer"><%= render "public/countdown_digits", capsule: capsule, skin: "amber" %></div>
      </div>
      <dl class="vault__meta">
        <div><dt><%= icon "calendar" %> 开启时间</dt><dd><%= render "public/detail_time", value: time_open, css: "mono" %></dd></div>
        <div><dt><%= icon "key" %> 胶囊码</dt><dd class="mono"><%= code %></dd></div>
        <div><dt><%= icon "heart" %> 在等它的人</dt><dd class="mono" data-detail-favorites><%= capsule[:favoriteCount] %></dd></div>
      </dl>
      <p class="tip"><%= icon "sparkle" %><span>不用刷新页面——倒计时归零的那一刻，它会自己打开。</span></p>
      <%= render "public/detail_actions", capsule: capsule %>
    </div>
  </section>
  <div class="opening" data-opening-panel hidden>
    <div class="opening__burst"></div><div class="opening__capsule"><%= render "skins/amber/capsule_art", code: code, opened: false, width: 300 %></div>
    <p class="opening__text" role="status">时间到了，正在开启……</p>
  </div>
<% end %>
