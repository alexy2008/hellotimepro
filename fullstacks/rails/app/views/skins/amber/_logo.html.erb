<% key = "amber-logo-#{SecureRandom.hex(5)}" %>
<svg class="logo <%= local_assigns[:css] %>" width="<%= size %>" height="<%= size %>" viewBox="0 0 64 64" aria-hidden="true">
  <defs>
    <linearGradient id="<%= key %>-shell" x2="1" y2="1">
      <stop offset="0" stop-color="var(--color-highlight)"/><stop offset="1" stop-color="var(--color-text)"/>
    </linearGradient>
    <linearGradient id="<%= key %>-cap" x2="1" y2="1">
      <stop offset="0" stop-color="var(--color-on-accent)"/><stop offset=".45" stop-color="var(--color-accent)"/><stop offset="1" stop-color="var(--color-favorite)"/>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="15" fill="url(#<%= key %>-shell)"/>
  <g transform="rotate(45 32 32)">
    <path d="M5 32A27 8 0 0 1 59 32" fill="none" stroke="var(--color-on-accent)" stroke-opacity=".56" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="1.5 3.4"/>
    <path d="M22 32V22a10 10 0 0 1 20 0v10Z" fill="url(#<%= key %>-cap)"/>
    <path d="M22 32v10a10 10 0 0 0 20 0V32Z" fill="var(--color-highlight-soft)"/>
    <rect x="26.5" y="35.5" width="11" height="10.5" rx="2" fill="var(--color-on-accent)" fill-opacity=".9"/>
    <path d="M28.8 39h6.4M28.8 42h4.6" stroke="var(--color-accent-text)" stroke-width="1.1" stroke-linecap="round"/>
    <rect x="20.6" y="30.4" width="22.8" height="3.2" rx="1.6" fill="var(--color-text)"/>
    <path d="M26.2 23a5.8 5.8 0 0 1 4.2-5.8M5 32A27 8 0 0 0 59 32" fill="none" stroke="var(--color-on-accent)" stroke-width="1.8" stroke-linecap="round"/>
    <circle cx="51" cy="37.2" r="2.6" fill="var(--color-accent)"/>
  </g>
  <path d="M13 43q.5 3.5 4 4-3.5.5-4 4-.5-3.5-4-4 3.5-.5 4-4Z" fill="var(--color-accent)"/>
  <circle cx="50.5" cy="13.5" r="1.4" fill="var(--color-on-accent)"/><circle cx="44" cy="8.5" r=".8" fill="var(--color-on-accent)"/>
</svg>
