<% hue = capsule_hue(code)
   width = local_assigns.fetch(:width, 200)
   key = "capsule-art-#{SecureRandom.hex(5)}" %>
<svg class="cart cart--<%= opened ? "opened" : "locked" %>" width="<%= width %>" height="<%= width / 2 %>" viewBox="0 0 240 120"
     style="--cap-glow: oklch(0.72 0.17 <%= hue %> / 0.34)" aria-hidden="true">
  <defs>
    <linearGradient id="<%= key %>-metal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="oklch(0.84 0.14 <%= hue %>)"/><stop offset="1" stop-color="oklch(0.63 0.19 <%= hue %>)"/>
    </linearGradient>
    <linearGradient id="<%= key %>-glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--color-surface)" stop-opacity=".62"/>
      <stop offset="1" stop-color="oklch(0.78 0.13 <%= (hue + 40) % 360 %>)" stop-opacity=".42"/>
    </linearGradient>
  </defs>
  <ellipse class="cart__shadow" cx="120" cy="107" rx="74" ry="6"/>
  <g class="cart__paper"><rect x="98" y="24" width="44" height="62" rx="5"/><path d="M106 40h28M106 50h28M106 60h17"/></g>
  <g class="cart__cap">
    <path d="M120 30H60a30 30 0 0 0 0 60h60Z" fill="url(#<%= key %>-metal)"/>
    <path class="cart__groove" d="M104 31v58M111 31v58"/><path class="cart__shine" d="M60 41h36"/>
  </g>
  <g class="cart__body">
    <path class="cart__glass" d="M120 30h60a30 30 0 0 1 0 60h-60Z" fill="url(#<%= key %>-glass)"/>
    <rect class="cart__scroll" x="133" y="46" width="46" height="28" rx="6"/>
    <path class="cart__scroll-line" d="M141 56h30M141 64h19"/><path class="cart__shine" d="M132 40h40"/>
  </g>
  <rect class="cart__seam" x="115.5" y="27" width="9" height="66" rx="4.5"/>
  <circle class="cart__lock" cx="120" cy="60" r="4.5"/>
</svg>
