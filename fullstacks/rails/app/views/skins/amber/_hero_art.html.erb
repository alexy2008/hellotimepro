<div class="hart" data-skin-only="amber" aria-hidden="true">
  <svg class="hart__svg" viewBox="0 0 600 600">
    <defs>
      <radialGradient id="hero-halo">
        <stop offset="0" stop-color="var(--color-accent)" stop-opacity=".36"/>
        <stop offset=".6" stop-color="var(--color-highlight)" stop-opacity=".13"/>
        <stop offset="1" stop-color="var(--color-highlight)" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="hero-arc" x2="1" y2="1">
        <stop offset="0" stop-color="var(--color-accent)"/><stop offset="1" stop-color="var(--color-favorite)"/>
      </linearGradient>
      <path id="hero-year-ring" d="M68 300a232 232 0 1 1 464 0a232 232 0 1 1-464 0"/>
    </defs>
    <circle class="hart__halo" cx="300" cy="300" r="260" fill="url(#hero-halo)"/>
    <g class="hart__ring hart__ring--outer">
      <circle class="hart__ticks" cx="300" cy="300" r="278"/>
      <circle class="hart__planet hart__planet--amber" cx="300" cy="22" r="5.5"/>
      <circle class="hart__planet hart__planet--cyan" cx="496.6" cy="496.6" r="3.6"/>
    </g>
    <g class="hart__ring hart__ring--years">
      <text class="hart__years"><textPath href="#hero-year-ring" textLength="1440" lengthAdjust="spacing"><%= (Time.current.year..Time.current.year + 20).to_a.join(" · ") %> ·</textPath></text>
    </g>
    <g class="hart__ring hart__ring--mid">
      <circle class="hart__line" cx="300" cy="300" r="204"/>
      <circle class="hart__major" cx="300" cy="300" r="204"/>
      <circle class="hart__planet hart__planet--violet" cx="96" cy="300" r="7"/>
    </g>
    <g class="hart__ring hart__ring--inner">
      <circle class="hart__dash" cx="300" cy="300" r="162"/>
      <circle class="hart__arc" cx="300" cy="300" r="162" stroke="url(#hero-arc)"/>
    </g>
    <ellipse class="hart__shadow" cx="300" cy="465" rx="96" ry="12"/>
    <% [[72, 96, 14], [522, 90, 9], [550, 452, 12], [60, 474, 8], [404, 226, 6]].each_with_index do |(x, y, size), index| %>
      <path class="hart__spark" style="animation-delay: <%= index * -0.7 %>s"
            d="M<%= x %> <%= y - size %>q2 <%= size - 2 %> <%= size %> <%= size %>q<%= 2 - size %> 2 <%= -size %> <%= size %>q-2 <%= 2 - size %> <%= -size %> <%= -size %>q<%= size - 2 %> -2 <%= size %> <%= -size %>Z"/>
    <% end %>
  </svg>
  <div class="hero-capsule"><div class="hart__capsule"><%= render "skins/amber/capsule_art", code: nil, opened: false, width: 305 %></div></div>
</div>
