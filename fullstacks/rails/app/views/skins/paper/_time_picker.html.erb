<div class="when" data-skin-only="paper" data-controller="paper-calendar"
     data-action="create:time-changed@window->paper-calendar#setTime hellotime:skin@document->paper-calendar#close">
  <div class="ruler" role="slider" tabindex="0" aria-label="开启时间标尺，左右拖动或按方向键调整"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-paper-calendar-target="ruler"
       data-action="pointerdown->paper-calendar#startSlide pointermove->paper-calendar#slide
                    lostpointercapture->paper-calendar#endSlide keydown->paper-calendar#rulerKey">
    <div class="ruler__strip" aria-hidden="true" data-paper-calendar-target="scale"></div>
    <div class="ruler__needle" aria-hidden="true"></div>
  </div>
  <div class="when__abs">
    <time class="mono" data-openat-control="paper" data-paper-calendar-target="date"></time>
    <button class="btn btn--ghost btn--sm" type="button" aria-expanded="false" aria-controls="paper-calendar" data-paper-calendar-target="trigger"
            data-action="paper-calendar#toggle"><%= icon "calendar" %> 日历选</button>
  </div>
  <div class="calwrap" id="paper-calendar" hidden data-paper-calendar-target="panel" data-action="keydown.esc->paper-calendar#close">
    <div class="calwrap__in cal">
      <div class="cal__head">
        <% [[-12, "«", "上一年"], [-1, "‹", "上个月"], [1, "›", "下个月"], [12, "»", "下一年"]].each do |delta, glyph, label| %>
          <% if delta == 1 %><b class="cal__title serif" data-paper-calendar-target="month"></b><% end %>
          <button class="cal__nav" type="button" data-months="<%= delta %>" aria-label="<%= label %>"
                  data-paper-calendar-target="navigation" data-action="paper-calendar#navigate"><%= glyph %></button>
        <% end %>
      </div>
      <div class="cal__dow"><% %w[一 二 三 四 五 六 日].each do |day| %><span><%= day %></span><% end %></div>
      <div class="cal__grid" data-paper-calendar-target="grid" role="grid" aria-label="日期"
           data-action="click->paper-calendar#pickDay keydown->paper-calendar#dayKey"></div>
      <div class="cal__time">
        <label class="cal__time-k" for="paper-time">时刻</label>
        <input id="paper-time" class="cal__t mono" type="time" data-paper-calendar-target="clock" data-action="change->paper-calendar#pickClock">
        <span class="cal__tz mono" data-paper-calendar-target="zone"></span>
      </div>
    </div>
  </div>
</div>
