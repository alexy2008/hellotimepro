<% opened = capsule[:isOpened]
   opened_at = capsule[:openAt]
   created_at = capsule[:createdAt]
   progress = waiting_progress(capsule) %>
<%= tag.article class: "cap cap--#{opened ? 'opened' : 'sealed'}", style: "--i: #{index}",
                data: capsule_attrs(capsule).merge(skin_only: "paper", view_testid: item_hook, personal_list_row: (item_hook == "fav-item")) do %>
  <div class="cap__bg" aria-hidden="true"><%= render "skins/paper/card_art", opened: opened %></div>
  <%= link_to "", capsule_path(capsule[:code]), class: "cap__link", aria: { label: capsule[:title] }, data: { view_testid: open_hook } %>
  <header class="cap__top">
    <span class="seal seal--<%= opened ? "line" : "solid" %>"><%= opened ? "启" : "封" %></span>
    <span class="cap__status"><%= opened ? "已开启" : "未开启" %></span>
    <% unless capsule[:inPlaza] %><span class="cap__private"><%= icon "lock" %> 未公开</span><% end %>
    <% if rank %><span class="cap__rank latin">No.<%= rank %></span><% end %>
    <span class="cap__code mono"><%= capsule[:code] %></span>
  </header>
  <h3 class="cap__title" data-view-testid="card-title"><%= capsule[:title] %></h3>
  <% if opened %>
    <p class="cap__preview"><%= capsule[:contentPreview] %></p>
    <div class="cap__when"><span>启于 <%= render "public/detail_time", value: opened_at, precise: false %></span>
      <i></i><span>在途 <%= duration_words(created_at, opened_at) %></span></div>
  <% else %>
    <div class="cap__veil" aria-hidden="true"><i></i><i></i></div>
    <div class="cap__cd"><span class="cap__cd-label">距启封</span>
      <span class="cap__cd-val"><%= render "shared/compact_countdown", open_at: opened_at %></span>
    </div>
    <div class="scale" style="--p: <%= progress %>%"><div class="scale__fill"></div><i class="scale__mark"></i></div>
    <div class="cap__ends mono">
      <%= render "public/detail_time", value: created_at, precise: false %>
      <%= render "public/detail_time", value: opened_at, precise: false %>
    </div>
  <% end %>
  <footer class="cap__foot">
    <span class="who"><%= avatar capsule[:creator][:avatarId] %><span class="who__n"><%= capsule[:creator][:nickname] %></span>
      <% if current_user&.nickname == capsule[:creator][:nickname] %><em class="who__me">我</em><% end %>
    </span>
    <%= render "public/favorite_button", capsule: capsule, scoped: true %>
  </footer>
<% end %>
