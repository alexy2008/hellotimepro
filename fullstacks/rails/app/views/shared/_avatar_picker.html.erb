<% items = AvatarService.list
   current = items.find { |item| item[:id] == selected } || items.first %>
<div <%= "data-controller=avatar-picker" if local_assigns.fetch(:nested, true) %>>
  <input type="hidden" name="avatarId" value="<%= current[:id] %>" data-avatar-picker-target="input">
  <div class="avpick" role="radiogroup" aria-label="选择头像">
    <% items.each do |item| %>
      <% active = current == item %>
      <button class="avpick__it <%= "is-sel" if active %>" type="button" role="radio" aria-checked="<%= active %>" aria-label="<%= item[:name] %>"
              tabindex="<%= active ? 0 : -1 %>" data-testid="avatar-option" data-value="<%= item[:id] %>" data-selected="<%= active %>"
              data-avatar-picker-target="option" data-action="avatar-picker#choose keydown->avatar-picker#move">
        <span data-skin-only="paper"><%= render "skins/paper/avatar_stamp", id: item[:id] %>
          <svg class="avpick__cancel" viewBox="0 0 64 80" aria-hidden="true"><circle cx="51" cy="65" r="14.5"/><circle cx="51" cy="65" r="10.5"/><path d="m45.5 65.5 4 4 7.5-8.5"/></svg>
        </span>
        <span class="avpick__planet" data-skin-only="amber"><%= avatar item[:id], "av--xl" %><span><%= item[:name] %></span></span>
      </button>
    <% end %>
  </div>
  <% items.each do |item| %>
    <div class="avpick__cap" data-avatar-picker-target="caption" data-value="<%= item[:id] %>" <%= "hidden" if current != item %>>
      <span data-skin-only="amber"><%= avatar item[:id] %></span><b><%= item[:name] %></b><span><%= AvatarService.caption(item[:id]) %></span>
    </div>
  <% end %>
</div>
