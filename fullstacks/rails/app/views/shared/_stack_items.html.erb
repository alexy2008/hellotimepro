<% stack_items.each do |item| %>
  <% if skin == "amber" %>
    <span class="ftr__tech" data-view-testid="stack-item" data-name="<%= item[:name] %>" title="<%= item[:version] %>">
      <%= render "shared/tech_icon", item: item, css: "tech-ic" %><%= item[:name] %>
    </span>
  <% else %>
    <li data-view-testid="stack-item" data-name="<%= item[:name] %>" title="<%= item[:version] %>">
      <%= render "shared/tech_icon", item: item, css: "tech__ic" %><span><%= item[:name] %></span><small class="mono"><%= item[:version] %></small>
    </li>
  <% end %>
<% end %>
