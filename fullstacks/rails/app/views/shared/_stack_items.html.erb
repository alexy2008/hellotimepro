<% stack_items.each do |item| %>
  <li class="ftr__tech" data-testid="stack-item" data-name="<%= item[:name] %>" title="<%= item[:version] %>">
    <% if item[:iconUrl] %><%= image_tag item[:iconUrl], alt: "", loading: "lazy" %><% else %><%= icon "code" %><% end %>
    <span><%= item[:name] %></span><small class="mono" data-skin-only="paper"><%= item[:version] %></small>
  </li>
<% end %>
