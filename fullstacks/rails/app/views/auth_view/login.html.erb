<div class="page page--auth">
  <div class="container auth">
    <%= render "auth_view/art" %>
    <section class="auth__main">
      <div class="auth__card card">
        <div class="overline eyebrow"><i></i>Welcome back</div>
        <h1 class="h1 page-title">欢迎回来</h1>
        <p class="page-lead">你封存的胶囊，还在等你回来开启。</p>
        <% if @return_path %><p class="tip"><%= icon "info" %> 登录后会带你回到刚才的页面。</p><% end %>
        <%= form_with url: login_path, html: { novalidate: true } do %>
          <%= hidden_field_tag :redirect, @return_path if @return_path %>
          <%= render "shared/account_field", label: "邮箱", name: "email", type: "email", autocomplete: "email", testid: "login-email", value: @email, placeholder: "you@example.com" %>
          <%= render "shared/account_field", label: "密码", name: "password", type: "password", autocomplete: "current-password", testid: "login-password" %>
          <% if @error %><div class="form__err" role="alert" data-testid="login-error"><%= @error %></div><% end %>
          <button class="btn btn--primary btn--lg btn--block" type="submit" data-testid="login-submit">登录 <%= icon "arrow" %></button>
        <% end %>
        <p class="auth__alt">还没有账号？ <%= link_to "注册一个", register_path(redirect: @return_path), data: { testid: "to-register" } %></p>
      </div>
    </section>
  </div>
</div>
