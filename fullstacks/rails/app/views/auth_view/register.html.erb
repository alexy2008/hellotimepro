<div class="page page--auth">
  <div class="container auth">
    <%= render "auth_view/art", register: true %>
    <section class="auth__main">
      <div class="auth__card auth__card--wide card">
        <div class="overline eyebrow"><i></i>Create account</div>
        <h1 class="h1 page-title">领一个身份</h1>
        <p class="page-lead">挑一个头像，然后写下你的第一枚胶囊。</p>
        <%= form_with url: register_path, html: { novalidate: true },
                      data: { controller: "account-form", action: "submit->account-form#validateNickname" } do %>
          <%= hidden_field_tag :redirect, @return_path if @return_path %>
          <div class="form__row">
            <%= render "shared/account_field", label: "邮箱", name: "email", type: "email", autocomplete: "email", testid: "register-email", value: @email, placeholder: "you@example.com" %>
            <%= render "shared/account_field", label: "昵称", name: "nickname", autocomplete: "nickname", testid: "register-nickname", value: @nickname, taken: @nickname_taken, placeholder: "2–20 个字符" %>
          </div>
          <%= render "shared/account_field", label: "密码", name: "password", type: "password", autocomplete: "new-password", testid: "register-password", placeholder: "至少 8 位，包含字母和数字" %>
          <div class="field field--plain">
            <div class="field__head"><span class="field__label">头像</span></div>
            <%= render "shared/avatar_picker", selected: @avatar_id || AvatarService.list.first[:id] %>
          </div>
          <% if @error %><div class="form__err" role="alert"><%= @error %></div><% end %>
          <button class="btn btn--primary btn--lg btn--block" type="submit" data-testid="register-submit">创建账号，开始写胶囊 <%= icon "arrow" %></button>
        <% end %>
        <p class="auth__alt">已经有账号？ <%= link_to "去登录", login_path(redirect: @return_path), data: { testid: "to-login" } %></p>
      </div>
    </section>
  </div>
</div>
