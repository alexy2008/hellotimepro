#!/usr/bin/env bash
# 一致性构建：安装 gem 依赖 + 构建 Tailwind 样式（让随后的 ./run 冷启动更快）。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

for _d in /opt/homebrew/opt/ruby/bin /opt/homebrew/opt/libpq/bin; do
  [[ -d "$_d" ]] && export PATH="$_d:$PATH"
done
_GEM_BIN="$(ls -d /opt/homebrew/lib/ruby/gems/*/bin 2>/dev/null | sort | tail -1 || true)"
[[ -n "${_GEM_BIN:-}" && -d "$_GEM_BIN" ]] && export PATH="$_GEM_BIN:$PATH"

bundle install
if [[ -f package.json ]] && command -v npm >/dev/null 2>&1; then
  [[ -d node_modules ]] || npm install --silent
  npm run --silent build:css
fi
echo "✓ Rails fullstack built"
