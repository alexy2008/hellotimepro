#!/usr/bin/env bash
# 启动 Rails 全栈服务器（端口 7181，含 /api/v1 JSON 接口 + Hotwire 服务端渲染 UI）。
#   DB_DRIVER=postgres (默认) 连接本机 PostgreSQL（连接信息见 data/.hello-state.json）
#   DB_DRIVER=sqlite          使用 data/sqlite/hellotime-rails.db
# DB_DRIVER / DB_URL / LLM_* 由 scripts/hello 注入。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

export REPO_ROOT
# hello 不注入 PORT；默认端口必须直接是登记端口 7181。
export PORT="${PORT:-7181}"
export DB_DRIVER="${DB_DRIVER:-postgres}"
export RAILS_ENV="${RAILS_ENV:-development}"
# 教学项目：固定 secret（开发态足够）。
export SECRET_KEY_BASE="${SECRET_KEY_BASE:-hellotime-rails-dev-secret-key-base-0001}"

# 系统 ruby（2.6）太旧；显式定位 Homebrew Ruby 4.x 及其 gem 可执行目录（子进程未必继承）。
for _d in /opt/homebrew/opt/ruby/bin /opt/homebrew/opt/libpq/bin; do
  [[ -d "$_d" ]] && export PATH="$_d:$PATH"
done
_GEM_BIN="$(ls -d /opt/homebrew/lib/ruby/gems/*/bin 2>/dev/null | sort | tail -1 || true)"
[[ -n "${_GEM_BIN:-}" && -d "$_GEM_BIN" ]] && export PATH="$_GEM_BIN:$PATH"

# 构建 Tailwind 样式（仅构建期 Node；运行期不依赖，已提交 public/css/app.css 兜底）。
if [[ -f package.json ]] && command -v npm >/dev/null 2>&1; then
  [[ -d node_modules ]] || { echo "首次运行：npm install（仅 @tailwindcss/cli）"; npm install --silent; }
  echo "→ 构建 Tailwind 样式 → public/css/app.css"
  npm run --silent build:css || echo "⚠ Tailwind 构建失败，使用已提交的 app.css"
fi

exec bundle exec rails server -e "$RAILS_ENV" -p "$PORT" -b 0.0.0.0
