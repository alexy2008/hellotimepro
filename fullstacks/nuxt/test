#!/usr/bin/env bash
# Nuxt 类型检查和 SQLite 服务回归；HTTP 契约层走仓库验证脚本。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

if [[ ! -d node_modules ]]; then
  npm install --silent
fi

npm run typecheck
exec ./node_modules/.bin/tsx --tsconfig .nuxt/tsconfig.json --test tests/*.test.ts
