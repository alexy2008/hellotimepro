# 复制为 .env 后按需修改

# 服务
PORT=7177
SERVICE_NAME=hellotime-pro
SERVICE_VERSION=0.1.0

# 数据库（postgres 或 sqlite）
DB_DRIVER=postgres
DB_URL=postgresql://hellotime:hellotime@127.0.0.1:55432/hellotime_pro
# DB_DRIVER=sqlite
# DB_URL=file:../../data/sqlite/hellotime.db

# JWT
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=10

# LLM（capsule-suggestion）
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=30000

# 限流
LOGIN_RATE_LIMIT_PER_MINUTE=10
