#!/usr/bin/env bash
# 默认使用临时 SQLite 数据库跑测试，零外部依赖且并发安全。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

if ! command -v mvn >/dev/null 2>&1; then
  for _d in \
      "$HOME/.vmr/versions/maven_versions"/*/bin \
      "$HOME/.sdkman/candidates/maven/current/bin" \
      /opt/homebrew/opt/maven/bin \
      /usr/local/opt/maven/bin \
      "$HOME/.m2/wrapper/dists"/*/*/bin; do
    if [[ -x "$_d/mvn" ]]; then
      export PATH="$_d:$PATH"
      break
    fi
  done
fi

export REPO_ROOT
export DB_DRIVER="${DB_DRIVER:-sqlite}"
if [[ "$DB_DRIVER" == "sqlite" ]]; then
  TEST_DB="$(mktemp "${TMPDIR:-/tmp}/hellotime-spring-mvc-test.XXXXXX")"
  trap 'unlink "$TEST_DB" 2>/dev/null || true' EXIT
  export SPRING_DATASOURCE_URL="jdbc:sqlite:$TEST_DB?transaction_mode=IMMEDIATE"
  export SPRING_DATASOURCE_DRIVER="org.sqlite.JDBC"
  export SPRING_JPA_DATABASE_PLATFORM="org.hibernate.community.dialect.SQLiteDialect"
  export SPRING_DATASOURCE_MAX_POOL_SIZE="${SPRING_DATASOURCE_MAX_POOL_SIZE:-1}"
  export SPRING_SQL_INIT_MODE="always"
  export SPRING_SQL_INIT_SCHEMA_LOCATIONS="file:$REPO_ROOT/spec/db/schema.sqlite.sql"
  export DB_USERNAME=""
  export DB_PASSWORD=""
fi

mvn test "$@"
