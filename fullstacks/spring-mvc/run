#!/usr/bin/env bash
# 启动 Spring MVC 全栈服务器（端口 7179，含 /api/v1 JSON 接口 + Thymeleaf/HTMX 双皮肤 SSR UI）。
#
#   DB_DRIVER=postgres (默认) 连接本机 PostgreSQL（连接信息见 data/.hello-state.json）
#   DB_DRIVER=sqlite          使用 ../../data/sqlite/hellotime.db
#
# 数据库 schema 由仓库级 ./scripts/db 维护；本脚本只负责启动服务。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

export REPO_ROOT
export DB_DRIVER="${DB_DRIVER:-postgres}"
export PORT="${PORT:-7179}"

# 子进程不继承 shell 的版本管理器 PATH（vmr/sdkman/...），逐个尝试常见位置。
if ! command -v mvn >/dev/null 2>&1; then
  for _d in \
      "$HOME/.vmr/versions/maven_versions"/*/bin \
      "$HOME/.sdkman/candidates/maven/current/bin" \
      /opt/homebrew/opt/maven/bin \
      /usr/local/opt/maven/bin \
      "$HOME/.m2/wrapper/dists"/*/*/bin; do
    if [[ -x "$_d/mvn" ]]; then
      export PATH="$_d:$PATH"
      break
    fi
  done
fi
if ! command -v mvn >/dev/null 2>&1; then
  echo "✗ 找不到 mvn。请先安装 Maven，或激活 vmr/sdkman。" >&2
  exit 2
fi

# 自托管字体（@fontsource）：缺失时自动安装，运行期由 Spring 静态资源直接映射。
if [[ -f package.json && ! -d node_modules/@fontsource ]] && command -v npm >/dev/null 2>&1; then
  echo "→ 安装自托管字体依赖 (@fontsource)…"
  npm install --silent --no-audit --no-fund
fi

if [[ "$DB_DRIVER" == "sqlite" ]]; then
  mkdir -p "$REPO_ROOT/data/sqlite"
  DB_URL="${DB_URL:-sqlite:///$REPO_ROOT/data/sqlite/hellotime.db}"
  DB_FILE="${DB_URL#sqlite:///}"
  export SPRING_DATASOURCE_URL="jdbc:sqlite:$DB_FILE?transaction_mode=IMMEDIATE"
  export SPRING_DATASOURCE_DRIVER="org.sqlite.JDBC"
  export SPRING_JPA_DATABASE_PLATFORM="org.hibernate.community.dialect.SQLiteDialect"
  export SPRING_DATASOURCE_MAX_POOL_SIZE="${SPRING_DATASOURCE_MAX_POOL_SIZE:-1}"
  export DB_USERNAME="${DB_USERNAME:-}"
  export DB_PASSWORD="${DB_PASSWORD:-}"
elif [[ "${DB_URL:-}" == postgresql+psycopg://* || "${DB_URL:-}" == postgresql://* || "${DB_URL:-}" == postgres://* ]]; then
  rest="${DB_URL#postgresql+psycopg://}"; rest="${rest#postgresql://}"; rest="${rest#postgres://}"
  auth_host="${rest%%/*}"
  db_name="${rest#*/}"
  auth="${auth_host%@*}"
  host_port="${auth_host#*@}"
  export DB_USERNAME="${DB_USERNAME:-${auth%%:*}}"
  export DB_PASSWORD="${DB_PASSWORD:-${auth#*:}}"
  export SPRING_DATASOURCE_URL="jdbc:postgresql://$host_port/$db_name"
else
  export SPRING_DATASOURCE_URL="${DB_URL:-jdbc:postgresql://127.0.0.1:5432/hellotime_pro}"
fi

JAR="target/spring-mvc-fullstack-2.0.0.jar"
if [[ ! -f "$JAR" ]] || [[ -n "$(find src pom.xml -newer "$JAR" -print -quit 2>/dev/null)" ]]; then
  mvn -q -DskipTests package
fi

exec java -jar "$JAR" "$@"
