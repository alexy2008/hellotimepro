#!/usr/bin/env bash
# 一致性构建：编译 Release 产物（让随后的 ./run 冷启动落在契约验证的就绪窗口内）。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1

dotnet build -c Release HelloTimePro.Aspnet.csproj
echo "✓ ASP.NET backend built"
