#!/usr/bin/env bash
# 启动 Axum 后端。DB_DRIVER / DB_URL / LLM_* 由 scripts/hello 注入；端口默认登记端口 29070。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

export REPO_ROOT
export DB_DRIVER="${DB_DRIVER:-postgres}"
# hello CLI 不注入 PORT，默认端口必须直接是登记端口。
export PORT="${PORT:-29070}"
# LLM 日志规范要求 INFO 级别可见。
export LOG_LEVEL="${LOG_LEVEL:-info}"

# 增量构建（已预热时秒级）；exec 保持同进程组，hello stop 的 killpg 才能连同清掉。
cargo build --release >&2
exec ./target/release/hellotime-axum
