#!/usr/bin/env bash
# 启动 FastAPI 参考后端。
#
#   DB_DRIVER=postgres (默认) 需要 `docker compose up -d postgres`
#   DB_DRIVER=sqlite          使用 ../../data/sqlite/hellotime.db
#
# 只启动服务；数据库初始化/重建/seed 请使用 scripts/db。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

if ! command -v uv >/dev/null 2>&1; then
  echo "需要 uv，请先安装：https://docs.astral.sh/uv/" >&2
  exit 1
fi

uv sync --quiet

# SQLite 默认路径
if [[ "${DB_DRIVER:-postgres}" == "sqlite" && -z "${DB_URL:-}" ]]; then
  mkdir -p "$REPO_ROOT/data/sqlite"
  export DB_URL="sqlite:///$REPO_ROOT/data/sqlite/hellotime.db"
fi

# 标准化 PostgreSQL scheme：postgresql:// / postgres:// → postgresql+psycopg://
# SQLAlchemy 2 + psycopg v3 需要显式指定驱动，否则默认尝试 psycopg2
if [[ "${DB_URL:-}" == postgresql://* ]]; then
  export DB_URL="postgresql+psycopg${DB_URL#postgresql}"
elif [[ "${DB_URL:-}" == postgres://* ]]; then
  export DB_URL="postgresql+psycopg${DB_URL#postgres}"
fi

PORT="${PORT:-29010}"
HOST="${HOST:-0.0.0.0}"
exec uv run uvicorn app.main:app --host "$HOST" --port "$PORT" "$@"
