#!/usr/bin/env bash
# 启动 HelloTime Pro Gin 后端（端口 29020）。
#
#   DB_DRIVER=postgres (默认) 使用 scripts/hello 注入的本地 PostgreSQL 连接
#   DB_DRIVER=sqlite          使用 ../../data/sqlite/hellotime.db
#
# 只启动服务；数据库初始化/重建/seed 请使用 scripts/db。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

export GIN_ROOT="$HERE"
export REPO_ROOT

if ! command -v go >/dev/null 2>&1; then
  echo "需要 Go，请先安装：https://go.dev/doc/install" >&2
  exit 1
fi

# SQLite 默认路径
if [[ "${DB_DRIVER:-postgres}" == "sqlite" && -z "${DB_URL:-}" ]]; then
  mkdir -p "$REPO_ROOT/data/sqlite"
  export DB_URL="sqlite:///$REPO_ROOT/data/sqlite/hellotime.db"
fi

# 标准化 PostgreSQL URL
if [[ "${DB_URL:-}" == postgresql://* ]]; then
  : # 已是标准格式，gorm/pgx 直接接受
elif [[ "${DB_URL:-}" == postgres://* ]]; then
  export DB_URL="postgresql${DB_URL#postgres}"
fi

PORT="${PORT:-29020}"
export PORT

exec go run ./cmd/server/. "$@"
