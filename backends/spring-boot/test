#!/usr/bin/env bash
# 默认使用 SQLite 跑测试，无需外部 PostgreSQL。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

export REPO_ROOT
export DB_DRIVER="${DB_DRIVER:-sqlite}"
if [[ "$DB_DRIVER" == "sqlite" ]]; then
  TEST_DB="$(mktemp "${TMPDIR:-/tmp}/hellotime-spring-test.XXXXXXXX")"
  trap 'unlink "$TEST_DB"' EXIT
  export SPRING_DATASOURCE_URL="jdbc:sqlite:$TEST_DB?transaction_mode=IMMEDIATE"
  export SPRING_DATASOURCE_DRIVER="org.sqlite.JDBC"
  export SPRING_JPA_DATABASE_PLATFORM="org.hibernate.community.dialect.SQLiteDialect"
  export SPRING_DATASOURCE_MAX_POOL_SIZE="${SPRING_DATASOURCE_MAX_POOL_SIZE:-1}"
  # 测试库是一次性的；启动测试上下文时显式应用 spec schema。生产 run 脚本仍不做任何 DB 维护。
  export SPRING_SQL_INIT_MODE="always"
  export SPRING_SQL_INIT_SCHEMA_LOCATIONS="file:$REPO_ROOT/spec/db/schema.sqlite.sql"
  export DB_USERNAME=""
  export DB_PASSWORD=""
fi

mvn test "$@"
