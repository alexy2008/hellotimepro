#!/usr/bin/env bash
# 启动 HelloTime Pro NestJS 后端（端口 29040）。
#
#   DB_DRIVER=postgres (默认) 需要 PostgreSQL
#   DB_DRIVER=sqlite          使用 ../../data/sqlite/hellotime-nest.db
#
# 只启动服务；数据库初始化/重建/seed 请使用 scripts/db。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$HERE/../.." && pwd)"
cd "$HERE"

export REPO_ROOT

if ! command -v node >/dev/null 2>&1; then
  echo "需要 Node.js，请先安装：https://nodejs.org/" >&2
  exit 1
fi

# SQLite 默认路径
if [[ "${DB_DRIVER:-postgres}" == "sqlite" && -z "${DB_URL:-}" ]]; then
  mkdir -p "$REPO_ROOT/data/sqlite"
  export DB_URL="sqlite:///$REPO_ROOT/data/sqlite/hellotime-nest.db"
fi

# 标准化 PostgreSQL URL
if [[ "${DB_URL:-}" == postgres://* ]]; then
  export DB_URL="postgresql${DB_URL#postgres}"
fi

if [[ ! -d node_modules ]]; then
  echo "[nest] 安装依赖..."
  npm install --prefer-offline 2>/dev/null || npm install
fi

PORT="${PORT:-29040}"
HOST="${HOST:-0.0.0.0}"
export PORT HOST

# 生产模式：先 build 再运行
if [[ "${NODE_ENV:-}" != "development" ]]; then
  echo "[nest] 编译..."
  npm run build
  exec node dist/main
else
  exec npm run start:dev
fi
