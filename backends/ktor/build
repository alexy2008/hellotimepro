#!/usr/bin/env bash
# 一致性构建：编译并预热 Gradle/依赖缓存（让随后的 ./run 冷启动落在契约验证的就绪窗口内）。
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

if [[ -z "${JAVA_HOME:-}" ]]; then
  for _jh in \
      /Library/Java/JavaVirtualMachines/jdk-21*.jdk/Contents/Home \
      "$HOME/.vmr/versions/jdk_versions"/*/Contents/Home \
      "$HOME/.sdkman/candidates/java/current"; do
    if [[ -x "$_jh/bin/java" ]]; then export JAVA_HOME="$_jh"; break; fi
  done
fi

./gradlew --console=plain -x test build
echo "✓ Ktor backend built"
