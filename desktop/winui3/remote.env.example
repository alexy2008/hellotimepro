# ============================================================
# WinUI 3 桌面端 · 远端 Windows 构建/运行主机配置（模板）
#
# WinUI 3 = Windows App SDK，编译与运行都只能在 Windows 上发生（无 macOS 交叉编译）。
# 本实现的形态是「远程构建」：代码留在 Mac 仓库，./build 同步源码到远端 Windows 主机
# 经 SSH 执行 dotnet build，./run 经反向 SSH 隧道让远端 app 访问 Mac 的 :9080 反代。
#
# 用法：cp remote.env.example remote.env，填入你自己的主机信息（remote.env 已 gitignore）。
# 前置：远端 Windows 装好 OpenSSH Server + 公钥免密、.NET SDK 8、VS 2022（含 WinUI/桌面负载）。
# ============================================================

# SSH 连接（免密公钥登录）
WINUI_SSH_HOST=your-windows-host.example.net
WINUI_SSH_PORT=22
WINUI_SSH_USER=you

# 远端工程目录（建议放数据盘，C 盘常紧张）。Windows 反斜杠路径 —— 必须加双引号，
# 否则 bash source 会把 \h 当转义吃掉反斜杠（变成 D:hello-winui3）。
WINUI_REMOTE_DIR="D:\hello-winui3"

# app 内 API base：默认经反向隧道打到 Mac 的 :9080 反代（127.0.0.1 是「远端机器自己」，
# 隧道把它转回 Mac）。一般不用改。
WINUI_API_BASE=http://127.0.0.1:9080
