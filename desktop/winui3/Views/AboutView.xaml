<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HelloTimePro.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HelloTimePro.Models"
    xmlns:helpers="using:HelloTimePro.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:AssetIconConverter x:Key="AssetIconConv" />
        <DataTemplate x:Key="StackIconTemplate" x:DataType="models:StackItem">
            <StackPanel Spacing="6" Width="72" HorizontalAlignment="Center">
                <Image Source="{x:Bind IconUrl, Converter={StaticResource AssetIconConv}}"
                       Width="40" Height="40" Stretch="Uniform" />
                <TextBlock Text="{x:Bind helpers:CardFmt.NameVersion(Name, Version)}" TextAlignment="Center"
                           TextWrapping="Wrap" FontFamily="Consolas" FontSize="{ThemeResource FontSizeXs}"
                           Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="24,40" HorizontalAlignment="Center" MaxWidth="760">
        <StackPanel Spacing="28" HorizontalAlignment="Stretch">

            <!-- 标题 + 简介 -->
            <StackPanel Spacing="10">
                <TextBlock FontSize="{ThemeResource FontSize4xl}" FontWeight="Bold">
                    <Run Text="关于 " Foreground="{ThemeResource TextPrimaryBrush}" /><Run Text="HelloTime Pro" Foreground="{ThemeResource BrandPrimaryBrush}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeLg}"
                           Text="一款时光胶囊应用——写下一段话，设定未来某刻才能开启，内容上锁后不可修改。支持胶囊广场浏览、AI 辅助创作、收藏与账户管理。同时也是一个多技术栈对比学习项目，同一份产品需求由多套前后端框架各自实现，共享同一份 API 契约、数据库 schema 与设计 token。" />
            </StackPanel>

            <!-- 桌面端技术栈 -->
            <StackPanel Spacing="14">
                <TextBlock Text="桌面端技术栈" FontSize="{ThemeResource FontSize2xl}" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <Border Padding="24" CornerRadius="{ThemeResource RadiusLg}"
                        Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <ItemsControl x:Name="DesktopStackIcons" ItemTemplate="{StaticResource StackIconTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="20" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" LineHeight="24"
                            Text="本应用是 HelloTime Pro 的 Windows 原生桌面端：用 WinUI 3（Windows App SDK）+ XAML 声明式重建整套界面，零 webview、零内嵌网页——与 Electron（自带 Chromium）/ Tauri（系统 WebView 内嵌前端）走的是完全不同的路，也不同于 SwiftUI / Flutter / Qt 等其它原生端。HttpClient + System.Text.Json 直连同一套 /api/v1 契约（默认经反向代理指向 :9080），不持有任何后端逻辑。状态层用 INotifyPropertyChanged 手写的轻量 Store（AppStore）整合会话、导航栈与主题，未引入额外的 MVVM 框架；网络层实现了信封解包、单飞 refresh 与 401 自动重放，与 Web 前端逐字对齐。SvgImageSource 原生渲染 SVG 头像与图标，无需像部分移动端那样降级为位图或色块。设计令牌经 codegen 生成 XAML ThemeDictionaries，驱动暗/亮主题实时切换。由于 WinUI 3 只能在 Windows 上编译运行，本实现采用远程构建：源码托管在跨平台仓库中，经 SSH 同步到远端 Windows 主机执行 dotnet build，并通过反向 SSH 隧道让原生窗口访问同一套后端服务。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 后端技术栈 -->
            <StackPanel Spacing="14">
                <TextBlock Text="后端技术栈" FontSize="{ThemeResource FontSize2xl}" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock x:Name="BackendError" Foreground="{ThemeResource DangerFgBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Border x:Name="BackendCard" Padding="24" CornerRadius="{ThemeResource RadiusLg}" Visibility="Collapsed"
                        Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <ItemsControl x:Name="BackendStackIcons" ItemTemplate="{StaticResource StackIconTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="20" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="BackendSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" LineHeight="24" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 底部元信息 -->
            <Grid Padding="0,16,0,0">
                <Border VerticalAlignment="Top" Height="1" Background="{ThemeResource BorderSubtleBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,16,0,0">
                    <TextBlock Foreground="{ThemeResource TextMutedBrush}" FontSize="{ThemeResource FontSizeSm}">
                        <Run Text="桌面端：" /><Run Text="WinUI 3 / C#" FontFamily="Consolas" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock x:Name="BackendMeta" Foreground="{ThemeResource TextMutedBrush}" FontSize="{ThemeResource FontSizeSm}" />
                    <TextBlock Text="License: MIT" Foreground="{ThemeResource TextMutedBrush}" FontSize="{ThemeResource FontSizeSm}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
