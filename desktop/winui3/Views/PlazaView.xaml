<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HelloTimePro.Views.PlazaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HelloTimePro.Models"
    xmlns:helpers="using:HelloTimePro.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:AvatarConverter x:Key="AvatarConv" />
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Stretch">
        <!-- Hero -->
        <Border Padding="24,40" Background="{ThemeResource Surface1Brush}">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="12">
                <TextBlock FontSize="{ThemeResource FontSize5xl}" FontWeight="Bold" TextWrapping="Wrap">
                    <Run Text="封存此刻 " Foreground="{ThemeResource TextPrimaryBrush}" /><Run Text="开启未来" Foreground="{ThemeResource AccentPrimaryBrush}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" MaxWidth="680" Foreground="{ThemeResource TextSecondaryBrush}"
                           Text="写下此刻最真实的想法，设定一个解封时刻——时间到了，它才会被打开。" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button x:Name="CreateCta" Content="✨ 创建我的胶囊" Click="OnCreate" Height="44" Padding="20,0"
                            Background="{ThemeResource BrandPrimaryBrush}" Foreground="{ThemeResource BrandOnBrush}" />
                    <Button Content="🔓 用胶囊码开启" Click="OnOpen" Height="44" Padding="20,0"
                            Background="{ThemeResource SuccessSolidBrush}" Foreground="{ThemeResource TextPrimaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 内容容器 -->
        <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Padding="24,24" Spacing="16">
            <!-- 工具栏 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="SortHot" Content="🔥 热门" Click="OnSortHot" />
                        <Button x:Name="SortNew" Content="✨ 最新" Click="OnSortNew" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="FilterAll" Content="全部" Click="OnFilterAll" />
                        <Button x:Name="FilterOpened" Content="已开启" Click="OnFilterOpened" />
                        <Button x:Name="FilterUnopened" Content="未开启" Click="OnFilterUnopened" />
                    </StackPanel>
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="🔍 搜索标题或昵称…"
                         MaxLength="50" TextChanged="OnSearchChanged" HorizontalAlignment="Right" Width="260" />
            </Grid>

            <!-- 状态提示 -->
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,24"
                       Foreground="{ThemeResource TextMutedBrush}" Visibility="Collapsed" />

            <!-- 卡片网格 -->
            <GridView x:Name="CardGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCardClick"
                      HorizontalAlignment="Stretch">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:CapsuleListItem">
                        <Border Width="320" Height="180" Margin="6" Padding="16" CornerRadius="{ThemeResource RadiusLg}"
                                Background="{ThemeResource PlazaCardBgBrush}" BorderBrush="{ThemeResource PlazaCardBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="{x:Bind helpers:CardFmt.BadgeText(IsOpened)}" HorizontalAlignment="Left"
                                               FontSize="{ThemeResource FontSizeXs}" Foreground="{ThemeResource SignalPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Code}" HorizontalAlignment="Right"
                                               FontFamily="Consolas" FontSize="{ThemeResource FontSizeXs}"
                                               Foreground="{ThemeResource TextMutedBrush}" />
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="{ThemeResource FontSizeLg}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <TextBlock Grid.Row="2" Text="{x:Bind helpers:CardFmt.SubLine(OpenAt, IsOpened, ContentPreview)}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}"
                                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"
                                           VerticalAlignment="Top" Margin="0,8,0,0" />

                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="{ThemeResource RadiusFull}">
                                            <Image Source="{x:Bind Creator.AvatarId, Converter={StaticResource AvatarConv}}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Creator.Nickname}" VerticalAlignment="Center"
                                                   FontSize="{ThemeResource FontSizeSm}" Foreground="{ThemeResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="8,4"
                                            Tag="{x:Bind Id}" Click="OnToggleFavorite"
                                            Content="{x:Bind helpers:CardFmt.FavText(FavoritedByMe, FavoriteCount)}"
                                            Foreground="{ThemeResource FavoriteActiveBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 分页 -->
            <StackPanel x:Name="Pager" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,16"
                        Visibility="Collapsed">
                <Button x:Name="PrevBtn" Content="上一页" Click="OnPrev" />
                <TextBlock x:Name="PageText" VerticalAlignment="Center" Foreground="{ThemeResource TextMutedBrush}"
                           FontSize="{ThemeResource FontSizeSm}" />
                <Button x:Name="NextBtn" Content="下一页" Click="OnNext" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
