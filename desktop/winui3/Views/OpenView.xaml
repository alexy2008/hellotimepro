<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HelloTimePro.Views.OpenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,56" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel MaxWidth="560" Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="用 8 位密钥开启胶囊" FontSize="{ThemeResource FontSize3xl}" FontWeight="Bold"
                       Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="输入朋友分享给你的 8 位大写字母和数字，可直接查看胶囊。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />

            <TextBox x:Name="CodeBox" MaxLength="8" Margin="0,16,0,0" HorizontalAlignment="Center"
                     Width="320" FontFamily="Consolas" FontSize="28" TextAlignment="Center"
                     PlaceholderText="XXXXXXXX" TextChanged="OnCodeChanged" />

            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource DangerFgBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="OpenButton" Content="开启 →" Click="OnOpen" Height="44" Padding="24,0" IsEnabled="False"
                        Background="{ThemeResource BrandPrimaryBrush}" Foreground="{ThemeResource BrandOnBrush}" />
                <Button Content="粘贴识别" Click="OnPaste" Height="44" Padding="20,0" />
            </StackPanel>

            <TextBlock Margin="0,24,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextMutedBrush}" FontSize="{ThemeResource FontSizeSm}"
                       Text="🔒 未到开启时间的胶囊也会显示倒计时" />
        </StackPanel>
    </Grid>
</UserControl>
