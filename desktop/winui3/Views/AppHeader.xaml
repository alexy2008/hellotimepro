<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HelloTimePro.Views.AppHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,10" ColumnSpacing="8" Background="{ThemeResource Surface1Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 品牌 -->
        <Button Grid.Column="0" x:Name="BrandButton" Background="Transparent" BorderThickness="0" Padding="4"
                Click="OnBrand">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="{ThemeResource RadiusMd}"
                        Background="{ThemeResource BrandPrimaryBrush}">
                    <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="HelloTime" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="20" />
                    <Run Text=" PRO" Foreground="{ThemeResource AccentPrimaryBrush}" FontWeight="Bold" FontSize="13" />
                </TextBlock>
            </StackPanel>
        </Button>

        <!-- 主导航 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button x:Name="NavPlaza" Content="广场" Background="Transparent" BorderThickness="0" Click="OnNavPlaza" />
            <Button x:Name="NavOpen" Content="开启" Background="Transparent" BorderThickness="0" Click="OnNavOpen" />
            <Button x:Name="NavAbout" Content="关于" Background="Transparent" BorderThickness="0" Click="OnNavAbout" />
        </StackPanel>

        <!-- 右侧操作 -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="ThemeButton" Width="34" Height="34" Padding="0" CornerRadius="{ThemeResource RadiusFull}"
                    Background="{ThemeResource Surface2Brush}" BorderThickness="0" Click="OnToggleTheme" ToolTipService.ToolTip="切换主题">
                <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- 未登录 -->
            <StackPanel x:Name="GuestPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="登录" Click="OnLogin" />
                <Button Content="注册" Click="OnRegister"
                        Background="{ThemeResource BrandPrimaryBrush}" Foreground="{ThemeResource BrandOnBrush}" />
            </StackPanel>

            <!-- 已登录 -->
            <Button x:Name="UserChip" Visibility="Collapsed" Background="Transparent"
                    BorderBrush="{ThemeResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource RadiusFull}" Padding="12,4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="UserName" Foreground="{ThemeResource TextSecondaryBrush}"
                               FontSize="{ThemeResource FontSizeSm}" VerticalAlignment="Center" />
                    <Border x:Name="UserAvatar" Width="24" Height="24" CornerRadius="{ThemeResource RadiusFull}"
                            Background="{ThemeResource BrandSubtleBrush}" />
                    <TextBlock Text="⌄" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="我创建的" Click="OnMeCreated" />
                        <MenuFlyoutItem Text="我收藏的" Click="OnMeFavorites" />
                        <MenuFlyoutItem Text="账号设置" Click="OnMeProfile" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="登出" Click="OnLogout" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
