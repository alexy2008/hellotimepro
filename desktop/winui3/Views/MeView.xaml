<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HelloTimePro.Views.MeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HelloTimePro.Models"
    xmlns:helpers="using:HelloTimePro.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:AvatarConverter x:Key="AvatarConv" />
        <DataTemplate x:Key="CapsuleCardTemplate" x:DataType="models:CapsuleListItem">
            <Border Width="320" Height="170" Margin="6" Padding="16" CornerRadius="{ThemeResource RadiusLg}"
                    Background="{ThemeResource PlazaCardBgBrush}" BorderBrush="{ThemeResource PlazaCardBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="{x:Bind helpers:CardFmt.BadgeText(IsOpened)}" HorizontalAlignment="Left"
                                   FontSize="{ThemeResource FontSizeXs}" Foreground="{ThemeResource SignalPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Code}" HorizontalAlignment="Right" FontFamily="Consolas"
                                   FontSize="{ThemeResource FontSizeXs}" Foreground="{ThemeResource TextMutedBrush}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Title}" FontSize="{ThemeResource FontSizeLg}" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind helpers:CardFmt.SubLine(OpenAt, IsOpened, ContentPreview)}"
                               Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="24,40" HorizontalAlignment="Center" MaxWidth="1120">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
            <!-- 子导航 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TabCreated" Content="我创建的" Click="OnTabCreated" />
                <Button x:Name="TabFavorites" Content="我收藏的" Click="OnTabFavorites" />
                <Button x:Name="TabProfile" Content="账号设置" Click="OnTabProfile" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center"
                       Margin="0,24" Visibility="Collapsed" />

            <!-- 列表：创建 / 收藏 -->
            <StackPanel x:Name="ListSection" Visibility="Collapsed">
                <GridView x:Name="CardGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCardClick"
                          ItemTemplate="{StaticResource CapsuleCardTemplate}" />
            </StackPanel>

            <!-- 资料 -->
            <StackPanel x:Name="ProfileSection" Spacing="12" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="账号设置" FontSize="{ThemeResource FontSize2xl}" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="昵称" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}" />
                <TextBox x:Name="NicknameBox" MaxLength="20" />
                <TextBlock Text="头像" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}" />
                <GridView x:Name="AvatarGrid" SelectionMode="Single" Height="150">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Avatar">
                            <Border Width="56" Height="56" Margin="4" CornerRadius="{ThemeResource RadiusFull}">
                                <Image Source="{x:Bind Id, Converter={StaticResource AvatarConv}}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <Button x:Name="SaveProfileButton" Content="保存资料" Click="OnSaveProfile"
                        Background="{ThemeResource BrandPrimaryBrush}" Foreground="{ThemeResource BrandOnBrush}" />

                <Border Height="1" Background="{ThemeResource BorderSubtleBrush}" Margin="0,12" />

                <TextBlock Text="修改密码" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <PasswordBox x:Name="CurrentPwd" PlaceholderText="当前密码" />
                <PasswordBox x:Name="NewPwd" PlaceholderText="新密码" />
                <Button x:Name="ChangePwdButton" Content="更新密码" Click="OnChangePassword" />

                <TextBlock x:Name="ProfileMsg" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
