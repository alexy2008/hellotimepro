<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="HelloTimePro.Views.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HelloTimePro.Models"
    xmlns:helpers="using:HelloTimePro.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:AvatarConverter x:Key="AvatarConv" />
    </UserControl.Resources>
    <Grid Padding="24,48" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border Width="480" Padding="32" CornerRadius="{ThemeResource RadiusXl}"
                Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="创建账号" FontSize="{ThemeResource FontSize3xl}" FontWeight="Bold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="给未来的自己，注册一个入口。" Foreground="{ThemeResource TextSecondaryBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="邮箱" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}" />
                <TextBox x:Name="EmailBox" InputScope="EmailNameOrAddress" />

                <TextBlock Text="昵称" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}"
                           Margin="0,8,0,0" />
                <TextBox x:Name="NicknameBox" MaxLength="20" />

                <TextBlock Text="密码" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}"
                           Margin="0,8,0,0" />
                <PasswordBox x:Name="PasswordBox" />

                <TextBlock Text="选择头像" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="{ThemeResource FontSizeSm}"
                           Margin="0,8,0,0" />
                <GridView x:Name="AvatarGrid" SelectionMode="Single" IsItemClickEnabled="False"
                          Height="150" Padding="4">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Avatar">
                            <Border Width="56" Height="56" Margin="4" CornerRadius="{ThemeResource RadiusFull}"
                                    ToolTipService.ToolTip="{x:Bind Name}">
                                <Image Source="{x:Bind Id, Converter={StaticResource AvatarConv}}" Stretch="UniformToFill" />
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock x:Name="ErrorText" Foreground="{ThemeResource DangerFgBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,4,0,0" />

                <Button x:Name="SubmitButton" Content="注册" Click="OnSubmit" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch" Height="44"
                        Background="{ThemeResource BrandPrimaryBrush}" Foreground="{ThemeResource BrandOnBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="已有账号？" Foreground="{ThemeResource TextMutedBrush}" FontSize="{ThemeResource FontSizeSm}" />
                    <HyperlinkButton Content="去登录" Padding="0" Click="OnGoLogin" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
