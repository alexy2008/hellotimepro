#!/usr/bin/env bash
# 启动 HelloTime Pro · SwiftUI 原生 macOS 桌面端。
#
# 纯原生：无 webview、无内嵌前端、无 dev server 端口 —— URLSession 直连后端。
# 与 electron/tauri 拉 Vite dev server 的做法根本不同。
#
# 后端 API 默认 :9080（hello switch 切换的反代），也可直连某后端：
#   BACKEND_PROXY=http://127.0.0.1:29010 ./run
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

if ! command -v swift >/dev/null 2>&1; then
  echo "需要 Swift 工具链（Xcode 或 Command Line Tools）。" >&2
  exit 1
fi

BACKEND_PROXY="${BACKEND_PROXY:-http://127.0.0.1:9080}"

echo "构建 SwiftUI 桌面端（首次较慢）…"
swift build

# 组装最小 .app bundle（仍是纯 SwiftPM，无 .xcodeproj）。
# 直接跑裸可执行文件没有 bundle id —— Dock 名/图标缺失，也无法被截图授权定位；
# 把二进制放进 .app/Contents/MacOS 后执行，macOS 即按 CFBundle 赋予应用身份。
APP="./.build/HelloTime Pro.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp Resources/Info.plist "$APP/Contents/Info.plist"
cp Resources/logo.svg "$APP/Contents/Resources/logo.svg"   # 品牌图标（Bundle.main 加载）
cp ./.build/debug/HelloTimeDesktop "$APP/Contents/MacOS/HelloTimeDesktop"

# 声明中文本地化：让 AppKit 把标准菜单（App/编辑/视图/窗口/帮助、关于/隐藏/退出等）
# 渲染成中文（与 .commands 注入的「前往」中文菜单一致）。空 lproj 即可声明该本地化。
mkdir -p "$APP/Contents/Resources/zh-Hans.lproj"
: > "$APP/Contents/Resources/zh-Hans.lproj/InfoPlist.strings"

echo "启动窗口（后端 API → ${BACKEND_PROXY}）"
# 前台 exec bundle 内二进制：进程本身即 GUI app，hello 据此判活；关窗即退出、连带被 hello stop 清理。
exec env BACKEND_PROXY="$BACKEND_PROXY" "$APP/Contents/MacOS/HelloTimeDesktop"
