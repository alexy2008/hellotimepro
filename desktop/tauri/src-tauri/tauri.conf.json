{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HelloTime Pro",
  "version": "1.0.0",
  "identifier": "pro.hellotime.tauri",
  "build": {
    "frontendDist": "../../../frontends/svelte/dist",
    "devUrl": "http://localhost:7191",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "HelloTime Pro · Tauri",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
