#!/usr/bin/env python3
# ============================================================
# HelloTime Pro · dev-manager v2（M0 骨架版）
#
# 单文件、零 pip 依赖（仅使用 Python 3.11+ 标准库）。
# M0 范围内实现 CLI 子命令：
#   hello doctor                  检查环境依赖
#   hello status                  当前启动状态
#   hello start <name>            启动一个实现
#   hello stop <name>             停止一个实现
#   hello restart-all             重启所有已启动的实现
#   hello switch <backend>        切换 :9080 代理目标
#   hello logs <name> [-n 200]    查看尾部日志
#   hello list                    显示所有已登记的实现
#
# Web UI（:9090）、真正的 TCP 代理与 HTMX 前端留到 M1 补齐。
#
# 实现原则：
# - 没有实现时优雅退出，明确告知 "stack 已登记但目录不存在"
# - 进程信息落盘在 data/.hello-state.json（见 docs/02-design.md §14.3）
# - 日志追加到 data/logs/<name>.log
# - 所有路径均相对于仓库根（本脚本所在目录的父目录）
# ============================================================

from __future__ import annotations
import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Optional

# --------------------------------------------------------------
# 路径与常量
# --------------------------------------------------------------
HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
DATA_DIR = ROOT / "data"
LOG_DIR = DATA_DIR / "logs"
STATE_FILE = DATA_DIR / ".hello-state.json"

# 端口登记（docs/02-design.md §4）
BACKENDS = {
    "spring":   {"dir": "backends/spring-boot",   "port": 29000, "runtime": "jdk"},
    "fastapi":  {"dir": "backends/fastapi",       "port": 29010, "runtime": "python"},
    "gin":      {"dir": "backends/gin",           "port": 29020, "runtime": "go"},
    "elysia":   {"dir": "backends/elysia",        "port": 29030, "runtime": "bun"},
    "nest":     {"dir": "backends/nest",          "port": 29040, "runtime": "node"},
    "aspnet":   {"dir": "backends/aspnet",        "port": 29050, "runtime": "dotnet"},
    "vapor":    {"dir": "backends/vapor",         "port": 29060, "runtime": "swift"},
    "axum":     {"dir": "backends/axum",          "port": 29070, "runtime": "rust"},
    "drogon":   {"dir": "backends/drogon",        "port": 29080, "runtime": "cmake"},
    "ktor":     {"dir": "backends/ktor",          "port": 29090, "runtime": "jdk"},
}

FRONTENDS = {
    "vue":      {"dir": "frontends/vue",          "port": 7173,  "runtime": "node"},
    "react":    {"dir": "frontends/react-ts",     "port": 7174,  "runtime": "node"},
    "angular":  {"dir": "frontends/angular",      "port": 7175,  "runtime": "node"},
    "svelte":   {"dir": "frontends/svelte",       "port": 7176,  "runtime": "node"},
    "solid":    {"dir": "frontends/solid",        "port": 7180,  "runtime": "node"},
}

FULLSTACKS = {
    "next":     {"dir": "fullstacks/next",        "port": 7177,  "runtime": "node"},
    "nuxt":     {"dir": "fullstacks/nuxt",        "port": 7178,  "runtime": "node"},
    "spring-mvc": {"dir": "fullstacks/spring-mvc","port": 7179,  "runtime": "jdk"},
    "rails":    {"dir": "fullstacks/rails",       "port": 7181,  "runtime": "ruby"},
    "laravel":  {"dir": "fullstacks/laravel",     "port": 7182,  "runtime": "php"},
}

PROXY_PORT = 9080
WEBUI_PORT = 9090

# --------------------------------------------------------------
# 终端颜色（无依赖，支持 NO_COLOR）
# --------------------------------------------------------------
NO_COLOR = bool(os.environ.get("NO_COLOR")) or not sys.stdout.isatty()

def c(code: str, s: str) -> str:
    if NO_COLOR:
        return s
    return f"\033[{code}m{s}\033[0m"

def green(s):  return c("32", s)
def red(s):    return c("31", s)
def yellow(s): return c("33", s)
def dim(s):    return c("2",  s)
def bold(s):   return c("1",  s)
def cyan(s):   return c("36", s)

# --------------------------------------------------------------
# 实现登记
# --------------------------------------------------------------
def all_stacks() -> dict:
    """返回 name -> {dir, port, runtime, kind}。"""
    merged = {}
    for k, v in BACKENDS.items():
        merged[k] = {**v, "kind": "backend"}
    for k, v in FRONTENDS.items():
        merged[k] = {**v, "kind": "frontend"}
    for k, v in FULLSTACKS.items():
        merged[k] = {**v, "kind": "fullstack"}
    return merged

def resolve_stack(name: str) -> Optional[dict]:
    stacks = all_stacks()
    if name in stacks:
        return {"name": name, **stacks[name]}
    print(red(f"未知实现: {name}"))
    print(dim("可用实现见 `hello list`"))
    return None

# --------------------------------------------------------------
# 状态文件
# --------------------------------------------------------------
@dataclass
class ProcessRecord:
    name: str
    pid: int
    port: int
    started_at: float
    log: str

@dataclass
class DbConfig:
    pg_host: str = "127.0.0.1"
    pg_port: int = 55432
    pg_db:   str = "hellotime_pro"
    pg_user: str = "hellotime"
    pg_pass: str = "hellotime"
    sqlite_path: str = "data/sqlite/hellotime.db"

@dataclass
class State:
    processes: dict = field(default_factory=dict)  # name -> ProcessRecord
    proxy_target: Optional[str] = None             # 当前 :9080 指向的 backend name
    proxy_pid: Optional[int] = None                # :9080 代理进程 PID
    db_driver: str = "postgres"
    db_config: DbConfig = field(default_factory=DbConfig)

    def save(self):
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        data = {
            "processes": {k: asdict(v) for k, v in self.processes.items()},
            "proxy_target": self.proxy_target,
            "proxy_pid": self.proxy_pid,
            "db_driver": self.db_driver,
            "db_config": asdict(self.db_config),
        }
        STATE_FILE.write_text(json.dumps(data, indent=2, ensure_ascii=False))

    @classmethod
    def load(cls) -> "State":
        if not STATE_FILE.exists():
            return cls()
        try:
            raw = json.loads(STATE_FILE.read_text())
            procs = {k: ProcessRecord(**v) for k, v in raw.get("processes", {}).items()}
            raw_cfg = raw.get("db_config", {})
            cfg = DbConfig(**{k: v for k, v in raw_cfg.items() if k in DbConfig.__dataclass_fields__})
            return cls(
                processes=procs,
                proxy_target=raw.get("proxy_target"),
                proxy_pid=raw.get("proxy_pid"),
                db_driver=raw.get("db_driver", "postgres"),
                db_config=cfg,
            )
        except Exception as e:
            print(yellow(f"⚠ 状态文件损坏（{e}），重置。"))
            return cls()

def _build_db_url(driver: str, cfg: DbConfig) -> str:
    if driver == "sqlite":
        path = cfg.sqlite_path
        if not os.path.isabs(path):
            path = str(ROOT / path)
        return f"sqlite:///{path}"
    return f"postgresql://{cfg.pg_user}:{cfg.pg_pass}@{cfg.pg_host}:{cfg.pg_port}/{cfg.pg_db}"

def is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False

def sweep_dead(state: State) -> None:
    """清理已死亡进程。"""
    dead = [name for name, p in state.processes.items() if not is_alive(p.pid)]
    for name in dead:
        del state.processes[name]
    if dead:
        state.save()

# --------------------------------------------------------------
# 子命令：list
# --------------------------------------------------------------
def cmd_list(args) -> int:
    stacks = all_stacks()
    print(bold("\n已登记实现（共 %d）\n" % len(stacks)))
    header = f"  {'name':<12} {'kind':<10} {'port':<6} {'runtime':<8} {'dir'}"
    print(dim(header))
    print(dim("  " + "-" * (len(header) - 2)))
    for name, info in sorted(stacks.items(), key=lambda x: (x[1]["kind"], x[1]["port"])):
        exists = (ROOT / info["dir"]).exists()
        mark = green("●") if exists else dim("○")
        print(f"  {mark} {name:<10} {info['kind']:<10} {info['port']:<6} {info['runtime']:<8} {info['dir']}")
    print()
    print(dim("  ● = 目录存在    ○ = 暂未实现"))
    return 0

# --------------------------------------------------------------
# 子命令：doctor
# --------------------------------------------------------------
def probe(cmd: str, *, version_flag: str = "--version") -> tuple[bool, str]:
    exe = shutil.which(cmd)
    if not exe:
        return False, ""
    try:
        out = subprocess.run(
            [exe, version_flag],
            capture_output=True, text=True, timeout=4,
        )
        text = out.stdout + out.stderr
        # 回退到无 flag 的形式（Go 等工具用 `go version`）
        if out.returncode != 0 or "not defined" in text:
            out = subprocess.run(
                [exe, "version"],
                capture_output=True, text=True, timeout=4,
            )
            text = out.stdout + out.stderr
        ver = text.splitlines()[0] if text else "(无版本输出)"
        return True, ver.strip()[:80]
    except Exception:
        return True, "(无法读取版本)"

def cmd_doctor(args) -> int:
    checks = [
        ("Docker",      "docker"),
        ("Docker Compose", "docker"),  # 用 docker compose 子命令，同一个 bin
        ("Python 3",    "python3"),
        ("Node.js",     "node"),
        ("Bun",         "bun"),
        ("Go",          "go"),
        ("Rust (cargo)", "cargo"),
        ("JDK (javac)", "javac"),
        ("Kotlin",      "kotlinc"),
        ("Swift",       "swift"),
        (".NET SDK",    "dotnet"),
        ("Ruby",        "ruby"),
        ("PHP",         "php"),
        ("CMake",       "cmake"),
        ("psql",        "psql"),
    ]
    print(bold("\n环境依赖检查\n"))
    ok_count = 0
    for label, cmd in checks:
        ok, ver = probe(cmd)
        if ok:
            ok_count += 1
            print(f"  {green('✓')} {label:<16} {dim(ver)}")
        else:
            print(f"  {yellow('○')} {label:<16} {dim('未安装（仅在要跑对应栈时需要）')}")

    # Postgres 容器可达性
    print()
    pg_ok = False
    try:
        out = subprocess.run(
            ["docker", "inspect", "-f", "{{.State.Running}}", "hellotime-pro-pg"],
            capture_output=True, text=True, timeout=3,
        )
        if out.returncode == 0 and out.stdout.strip() == "true":
            pg_ok = True
            print(f"  {green('✓')} {'Postgres 容器':<16} {dim('运行中（hellotime-pro-pg）')}")
        else:
            print(f"  {yellow('○')} {'Postgres 容器':<16} {dim('未运行 · 试试: docker compose up -d postgres')}")
    except Exception:
        print(f"  {yellow('○')} {'Postgres 容器':<16} {dim('Docker 未就绪')}")

    # 目录检查
    print()
    for sub in ["spec", "ui-prototype", "data"]:
        p = ROOT / sub
        if p.exists():
            print(f"  {green('✓')} {'目录 ' + sub:<16} {dim(str(p.relative_to(ROOT)))}")
        else:
            print(f"  {red('✗')} {'目录 ' + sub:<16} {dim('缺失')}")

    print()
    print(dim(f"  通过: {ok_count}/{len(checks)} 基础工具 + Postgres={'✓' if pg_ok else '○'}"))
    print()
    return 0 if ok_count >= 2 else 1

# --------------------------------------------------------------
# 子命令：status
# --------------------------------------------------------------
def cmd_status(args) -> int:
    state = State.load()
    sweep_dead(state)

    print(bold("\n当前状态\n"))
    if not state.processes:
        print(dim("  （没有正在运行的实现）"))
    else:
        print(dim(f"  {'name':<12} {'pid':<8} {'port':<6} {'uptime'}"))
        print(dim("  " + "-" * 50))
        now = time.time()
        for name, p in state.processes.items():
            dur = int(now - p.started_at)
            uptime = f"{dur // 3600}h{(dur % 3600) // 60}m{dur % 60}s"
            print(f"  {green('●')} {name:<10} {p.pid:<8} {p.port:<6} {uptime}")

    print()
    print(f"  :{PROXY_PORT} 代理指向：{cyan(state.proxy_target or '（未设置）')}")
    print(f"  DB_DRIVER   = {cyan(state.db_driver)}")
    print(f"  Web UI      = http://127.0.0.1:{WEBUI_PORT}  {dim('(hello web 启动)')}")
    print()
    return 0

# --------------------------------------------------------------
# 核心操作（CLI 与 Web 共用）
# --------------------------------------------------------------
def op_start(name: str) -> dict:
    """启动一个实现，返回 {ok, code, msg, pid?, port?}。"""
    stacks = all_stacks()
    if name not in stacks:
        return {"ok": False, "code": 2, "msg": f"未知实现: {name}"}
    info = stacks[name]
    state = State.load()
    sweep_dead(state)

    if name in state.processes:
        p = state.processes[name]
        return {"ok": True, "code": 0, "msg": f"已经在运行 pid={p.pid}",
                "pid": p.pid, "port": p.port, "already": True}

    stack_dir = ROOT / info["dir"]
    if not stack_dir.exists():
        return {"ok": False, "code": 3,
                "msg": f"目录不存在: {info['dir']}（该栈还未实现）"}

    run_script = stack_dir / "run"
    if not run_script.exists():
        return {"ok": False, "code": 4,
                "msg": f"缺少启动脚本: {info['dir']}/run"}

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"{name}.log"
    log_f = log_path.open("a", buffering=1)
    log_f.write(f"\n\n=== start at {time.strftime('%Y-%m-%d %H:%M:%S')} ===\n")

    try:
        proc = subprocess.Popen(
            ["./run"],
            cwd=stack_dir,
            stdout=log_f,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            env={**os.environ,
                 "DB_DRIVER": state.db_driver,
                 "DB_URL": _build_db_url(state.db_driver, state.db_config)},
        )
    except Exception as e:
        return {"ok": False, "code": 5, "msg": f"启动失败: {e}"}

    state.processes[name] = ProcessRecord(
        name=name, pid=proc.pid, port=info["port"],
        started_at=time.time(), log=str(log_path),
    )
    state.save()
    return {"ok": True, "code": 0,
            "msg": f"已启动 {name} pid={proc.pid} port={info['port']}",
            "pid": proc.pid, "port": info["port"]}

def op_stop(name: str) -> dict:
    state = State.load()
    sweep_dead(state)
    if name not in state.processes:
        return {"ok": True, "code": 0, "msg": f"{name} 不在运行中"}
    p = state.processes[name]
    try:
        os.killpg(os.getpgid(p.pid), signal.SIGTERM)
        for _ in range(50):
            if not is_alive(p.pid):
                break
            time.sleep(0.1)
        if is_alive(p.pid):
            os.killpg(os.getpgid(p.pid), signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError as e:
        return {"ok": False, "code": 6, "msg": f"无法杀进程 {p.pid}: {e}"}
    del state.processes[name]
    state.save()
    return {"ok": True, "code": 0, "msg": f"已停止 {name}"}

def op_stop_external(name: str) -> dict:
    """Kill the process listening on the stack's port (externally-started service)."""
    stacks = all_stacks()
    if name not in stacks:
        return {"ok": False, "code": 2, "msg": f"未知实现: {name}"}
    port = stacks[name]["port"]
    try:
        out = subprocess.run(
            ["lsof", "-ti", f"TCP:{port}"],
            capture_output=True, text=True, timeout=3,
        )
        pids = [int(p) for p in out.stdout.split() if p.strip().isdigit()]
    except Exception as e:
        return {"ok": False, "code": 7, "msg": f"lsof 失败: {e}"}
    if not pids:
        return {"ok": True, "code": 0, "msg": f"端口 {port} 无进程监听"}
    killed = []
    for pid in pids:
        try:
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
            except (ProcessLookupError, OSError):
                os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not is_alive(pid):
                    break
                time.sleep(0.1)
            if is_alive(pid):
                os.kill(pid, signal.SIGKILL)
            killed.append(pid)
        except PermissionError as e:
            return {"ok": False, "code": 6, "msg": f"无权 kill pid {pid}: {e}"}
        except ProcessLookupError:
            killed.append(pid)
    # 如果该进程之前也被 hello 管理（不寻常但可能），清一下状态
    state = State.load()
    if name in state.processes:
        del state.processes[name]
        state.save()
    return {"ok": True, "code": 0, "msg": f"已停止 {name}（pid {killed}）"}

_PROXY_SCRIPT = """
import socket, threading, sys

target_port = int(sys.argv[1])

def pipe(src, dst):
    try:
        while True:
            d = src.recv(4096)
            if not d:
                break
            dst.sendall(d)
    except Exception:
        pass
    finally:
        for s in (src, dst):
            try: s.close()
            except Exception: pass

srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('0.0.0.0', {proxy_port}))
srv.listen(128)
while True:
    c, _ = srv.accept()
    try:
        b = socket.create_connection(('127.0.0.1', target_port), timeout=5)
        threading.Thread(target=pipe, args=(c, b), daemon=True).start()
        threading.Thread(target=pipe, args=(b, c), daemon=True).start()
    except Exception:
        c.close()
"""

def _kill_proxy_pid(pid: Optional[int]) -> None:
    """Kill a proxy process by PID (best-effort)."""
    if pid is None:
        return
    try:
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except (ProcessLookupError, OSError):
            os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not is_alive(pid):
                break
            time.sleep(0.05)
        if is_alive(pid):
            os.kill(pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass

def _kill_port(port: int) -> None:
    """Kill whatever process is listening on port (best-effort, handles orphans)."""
    try:
        out = subprocess.run(
            ["lsof", "-ti", f"TCP:{port}"],
            capture_output=True, text=True, timeout=3,
        )
        for p in out.stdout.split():
            if p.strip().isdigit():
                _kill_proxy_pid(int(p))
    except Exception:
        pass

def _start_proxy(target_port: int) -> int:
    """Start a Python TCP proxy on PROXY_PORT → target_port. Returns PID."""
    script = _PROXY_SCRIPT.format(proxy_port=PROXY_PORT)
    proc = subprocess.Popen(
        [sys.executable, "-c", script, str(target_port)],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(0.15)  # give the socket a moment to bind
    return proc.pid

def op_switch(backend: str) -> dict:
    if backend not in BACKENDS:
        return {"ok": False, "code": 2, "msg": f"未知后端: {backend}"}
    target_port = BACKENDS[backend]["port"]
    state = State.load()
    # Kill existing proxy (tracked PID first, then sweep the port for orphans)
    _kill_proxy_pid(state.proxy_pid)
    _kill_port(PROXY_PORT)
    pid = _start_proxy(target_port)
    state.proxy_target = backend
    state.proxy_pid = pid
    state.save()
    return {"ok": True, "code": 0,
            "msg": f":{PROXY_PORT} → {backend} (:{target_port})，代理 pid={pid}"}

def op_set_db_driver(driver: str) -> dict:
    if driver not in ("postgres", "sqlite"):
        return {"ok": False, "code": 2, "msg": f"未知 DB_DRIVER: {driver}"}
    state = State.load()
    state.db_driver = driver
    state.save()
    return {"ok": True, "code": 0, "msg": f"DB_DRIVER = {driver}（重启已运行的服务后生效）"}

def op_set_db_config(cfg: dict) -> dict:
    state = State.load()
    c = state.db_config
    for k in ("pg_host", "pg_db", "pg_user", "pg_pass", "sqlite_path"):
        if k in cfg and cfg[k] is not None:
            setattr(c, k, str(cfg[k]).strip())
    if "pg_port" in cfg:
        try:
            c.pg_port = int(cfg["pg_port"])
        except (ValueError, TypeError):
            return {"ok": False, "code": 2, "msg": "pg_port 必须是数字"}
    state.save()
    return {"ok": True, "code": 0, "msg": "数据库连接已保存（重启服务后生效）"}

def op_logs(name: str, n: int = 200) -> str:
    log_path = LOG_DIR / f"{name}.log"
    if not log_path.exists():
        return ""
    with log_path.open("rb") as f:
        f.seek(0, 2)
        size = f.tell()
        # 取最近 ~64KB，足够覆盖几百行
        back = min(size, 65536)
        f.seek(size - back)
        text = f.read().decode("utf-8", errors="replace")
    lines = text.splitlines()[-n:]
    return "\n".join(lines)

def op_clear_log(name: str) -> dict:
    log_path = LOG_DIR / f"{name}.log"
    try:
        log_path.write_text("", encoding="utf-8")
        return {"ok": True, "msg": f"已清空 {name} 日志"}
    except Exception as e:
        return {"ok": False, "msg": str(e)}

# --------------------------------------------------------------
# 子命令：start / stop / restart-all
# --------------------------------------------------------------
def cmd_start(args) -> int:
    res = op_start(args.name)
    if not res["ok"]:
        print(red(res["msg"]))
        if res["code"] == 2:
            print(dim("可用实现见 `hello list`"))
        elif res["code"] == 3:
            print(dim("该栈还未在 M1+ 实现，无法启动。"))
        elif res["code"] == 4:
            print(dim("按约定每个实现需提供可执行的 ./run 脚本。"))
        return res["code"]
    if res.get("already"):
        print(yellow(res["msg"]))
    else:
        print(green(f"✓ {res['msg']}"))
        print(dim(f"  日志: tail -f data/logs/{args.name}.log"))
    return 0

def cmd_stop(args) -> int:
    res = op_stop(args.name)
    if not res["ok"]:
        print(red(res["msg"]))
        return res["code"]
    if "已停止" in res["msg"]:
        print(green(f"✓ {res['msg']}"))
    else:
        print(dim(res["msg"]))
    return 0

def cmd_restart_all(args) -> int:
    state = State.load()
    sweep_dead(state)
    names = list(state.processes.keys())
    if not names:
        print(dim("（没有正在运行的实现）"))
        return 0
    for name in names:
        cmd_stop(argparse.Namespace(name=name))
    for name in names:
        cmd_start(argparse.Namespace(name=name))
    return 0

# --------------------------------------------------------------
# 子命令：switch
# --------------------------------------------------------------
def cmd_switch(args) -> int:
    res = op_switch(args.backend)
    if not res["ok"]:
        print(red(res["msg"]))
        print(dim("可选: " + ", ".join(BACKENDS.keys())))
        return res["code"]
    print(green(f"✓ {res['msg']}"))
    return 0

# --------------------------------------------------------------
# 子命令：logs
# --------------------------------------------------------------
def cmd_logs(args) -> int:
    log_path = LOG_DIR / f"{args.name}.log"
    if not log_path.exists():
        print(dim(f"没有日志文件: {log_path.relative_to(ROOT)}"))
        return 0
    text = op_logs(args.name, args.n)
    if text:
        print(text)
    return 0

# --------------------------------------------------------------
# Web 健康探测与快照
# --------------------------------------------------------------
def op_health(name: str, timeout: float = 3.0) -> dict:
    """调用实现的 /api/v1/health 端点，返回技术栈信息。"""
    from urllib.request import urlopen
    from urllib.error import URLError, HTTPError
    stacks = all_stacks()
    if name not in stacks:
        return {"ok": False, "error": "未知实现"}
    port = stacks[name]["port"]
    t0 = time.time()
    try:
        with urlopen(f"http://127.0.0.1:{port}/api/v1/health", timeout=timeout) as r:
            body = json.loads(r.read().decode("utf-8"))
            return {"ok": True, "latency_ms": int((time.time() - t0) * 1000), "body": body}
    except (HTTPError, URLError, OSError) as e:
        return {"ok": False, "error": str(e)}

def op_snapshot() -> dict:
    """构造 web 前端轮询用的快照。并发 TCP 探活，识别外部启动的服务。"""
    import socket as _sock
    from concurrent.futures import ThreadPoolExecutor

    def _tcp_probe(port: int) -> bool:
        try:
            with _sock.create_connection(("127.0.0.1", port), timeout=0.25):
                return True
        except Exception:
            return False

    state = State.load()
    sweep_dead(state)
    stacks = all_stacks()
    now = time.time()

    stack_list = list(stacks.items())
    with ThreadPoolExecutor(max_workers=len(stack_list)) as ex:
        port_open_map = dict(zip(
            [n for n, _ in stack_list],
            ex.map(lambda x: _tcp_probe(x[1]["port"]), stack_list),
        ))

    items = []
    for name, info in stack_list:
        rec = state.processes.get(name)
        stack_dir = ROOT / info["dir"]
        items.append({
            "name": name,
            "kind": info["kind"],
            "port": info["port"],
            "runtime": info["runtime"],
            "dir": info["dir"],
            "implemented": stack_dir.exists() and (stack_dir / "run").exists(),
            "running": rec is not None,
            "port_open": port_open_map.get(name, False),
            "pid": rec.pid if rec else None,
            "started_at": rec.started_at if rec else None,
            "uptime_s": int(now - rec.started_at) if rec else 0,
        })
    return {
        "stacks": items,
        "proxy_target": state.proxy_target,
        "proxy_port": PROXY_PORT,
        "db_driver": state.db_driver,
        "db_config": asdict(state.db_config),
        "now": now,
    }

