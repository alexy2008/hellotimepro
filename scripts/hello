function iconEl(name){
  const t = ICONS[name] || [`<text x="3" y="17" font-family="monospace" font-weight="700" font-size="13" fill="#888">${name.slice(0,2).toUpperCase()}</text>`, "#888"];
  const ic = document.createElement("div");
  ic.className = "icon";
  const rgb = hexToRgb(t[1].replace("#",""));
  ic.style.setProperty("--ic-rgb", rgb);
  ic.innerHTML = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">${t[0]}</svg>`;
  return ic;
}

function hexToRgb(h){
  const n = parseInt(h, 16);
  return [(n>>16)&255,(n>>8)&255,n&255].join(",");
}

let snap = null, logTarget = null, logTimer = null;

function fmtUp(s){
  if(!s) return "";
  if(s<60) return s+"s";
  const m=Math.floor(s/60);
  if(m<60) return `${m}m${s%60}s`;
  return `${Math.floor(m/60)}h${m%60}m`;
}

function toast(msg,k="ok"){
  const el=document.createElement("div");
  el.className="toast "+k; el.textContent=msg;
  $("#toasts").appendChild(el);
  setTimeout(()=>el.remove(), 3200);
}

async function api(path,opts={}){
  const r=await fetch(path,{headers:{"Content-Type":"application/json"},...opts});
  if(!r.ok) throw new Error("HTTP "+r.status);
  return r.json();
}

async function refresh(){
  try{
    const j=await api("/api/snapshot");
    snap=j.data; render();
  }catch(e){ $("#liveLabel").textContent="离线"; }
}

function render(){
  if(!snap) return;
  $("#liveLabel").textContent = "实时";
  const backends = snap.stacks.filter(s=>s.kind==="backend");

  const sel=$("#proxySel");
  if(sel.options.length===0){
    backends.forEach(b=>{
      const o=document.createElement("option");
      o.value=b.name; o.textContent=`${b.name} · :${b.port}`;
      sel.appendChild(o);
    });
  }
  if(snap.proxy_target) sel.value=snap.proxy_target;
  const px=$("#proxyState");
  if(snap.proxy_target){
    const t=backends.find(b=>b.name===snap.proxy_target);
    px.textContent=t?`${snap.proxy_target} · :${t.port}`:snap.proxy_target;
    px.className="badge b-sig";
  }else{
    px.textContent="未设置"; px.className="badge b-dim";
  }
  $("#dbSel").value=snap.db_driver;
  $("#dbState").textContent=snap.db_driver;
  syncDbTabs(snap.db_driver);
  // header status chips
  const hp=$("#hdrProxy");
  if(snap.proxy_target){
    const t=snap.stacks.find(s=>s.name===snap.proxy_target);
    hp.textContent=snap.proxy_target+(t?` :${t.port}`:"");
    hp.className="val sig";
  }else{
    hp.textContent="未设置"; hp.className="val dim";
  }
  const cfg2=snap.db_config||{};
  const dbDetail=snap.db_driver==="sqlite"
    ?(cfg2.sqlite_path||"").replace(/.*\//,"")
    :`${cfg2.pg_host||""}:${cfg2.pg_port||""}/${cfg2.pg_db||""}`;
  $("#hdrDb").textContent=snap.db_driver+" · "+dbDetail;
  const cfg=snap.db_config||{};
  if(!$("#pgHost").matches(":focus")) $("#pgHost").value=cfg.pg_host||"";
  if(!$("#pgPort").matches(":focus")) $("#pgPort").value=cfg.pg_port||"";
  if(!$("#pgDb").matches(":focus"))   $("#pgDb").value=cfg.pg_db||"";
  if(!$("#pgUser").matches(":focus")) $("#pgUser").value=cfg.pg_user||"";
  if(!$("#pgPass").matches(":focus")) $("#pgPass").value=cfg.pg_pass||"";
  if(!$("#sqlitePath").matches(":focus")) $("#sqlitePath").value=cfg.sqlite_path||"";

  const groups={backend:[],frontend:[],fullstack:[]};
  snap.stacks.forEach(s=>groups[s.kind].push(s));
  Object.keys(groups).forEach(k=>groups[k].sort((a,b)=>a.port-b.port));

  const root=$("#sections");
  const sy=window.scrollY;
  root.innerHTML="";
  ["backend","frontend","fullstack"].forEach(kind=>{
    const list=groups[kind]; if(!list.length) return;
    const sec=document.createElement("section");
    sec.className="section"; sec.dataset.kind=kind;
    const running=list.filter(s=>s.running).length;
    const ext=list.filter(s=>!s.running&&s.port_open).length;
    const impl=list.filter(s=>s.implemented).length;
    const sh=document.createElement("div"); sh.className="sh";
    sh.innerHTML=`<h2><span class="sbar"></span>${KL[kind]}</h2><span class="scount">${running} 管理运行${ext?" · "+ext+" 外部":""} · ${impl} 已实现 · ${list.length} 登记</span>`;
    const grid=document.createElement("div"); grid.className="grid";
    list.forEach(s=>grid.appendChild(buildCard(s,kind)));
    sec.appendChild(sh); sec.appendChild(grid);
    root.appendChild(sec);
  });
  window.scrollTo(0,sy);
}

function buildCard(s,kind){
  const card=document.createElement("div");
  const managed=s.running;
  const external=!s.running&&s.port_open;
  let cls="card";
  if(managed) cls+=" managed";
  else if(external) cls+=" external";
  if(!s.implemented) cls+=" unimpl";
  card.className=cls;

  const bar=document.createElement("div"); bar.className="card-bar"; card.appendChild(bar);
  const shine=document.createElement("div"); shine.className="shine"; card.appendChild(shine);

  /* header */
  const ch=document.createElement("div"); ch.className="ch";
  ch.appendChild(iconEl(s.name));
  const ci=document.createElement("div"); ci.className="ci";
  const active=managed||external;
  const portHtml=active
    ?`<a href="http://127.0.0.1:${s.port}" target="_blank" rel="noopener">:${s.port}</a>`
    :":"+s.port;
  ci.innerHTML=`<div class="cname">${s.name}</div><div class="cport">${portHtml}</div>`;
  ch.appendChild(ci);
  card.appendChild(ch);

  /* status */
  const cs=document.createElement("div"); cs.className="cs";
  if(managed){
    cs.innerHTML=`<span class="dot run"></span><span class="badge b-ok" style="font-size:10px">运行中</span><span class="uptime">${fmtUp(s.uptime_s)}</span><span class="badge b-dim" style="font-size:9px">pid&nbsp;${s.pid}</span>`;
  }else if(external){
    cs.innerHTML=`<span class="dot ext"></span><span class="badge b-ext" style="font-size:10px">外部运行</span>`;
  }else if(s.implemented){
    cs.innerHTML=`<span class="dot"></span><span class="badge b-dim" style="font-size:10px">未启动</span>`;
  }else{
    cs.innerHTML=`<span class="dot ud"></span><span class="badge b-dim" style="font-size:10px">未实现</span>`;
  }
  card.appendChild(cs);

  /* actions */
  const ca=document.createElement("div"); ca.className="ca";
  if(managed){
    btn(ca,"bdanger","stop","停止");
    btn(ca,"brestart","restart","重启");
    btn(ca,"ghost","logs","日志");
  }else if(external){
    btn(ca,"bdanger","stop-ext","停止");
    btn(ca,"ghost","logs","日志");
  }else if(s.implemented){
    btn(ca,"pri","start","启动");
    btn(ca,"ghost","logs","日志");
  }else{
    const b=document.createElement("button"); b.disabled=true; b.className="ghost"; b.textContent="未实现"; ca.appendChild(b);
  }
  if((kind==="frontend"||kind==="fullstack")&&(managed||external)){
    btn(ca,"bopen","open","打开");
  }
  if(kind==="backend"&&(s.implemented||external)){
    btn(ca,"bhealth","health","检查");
  }
  $$("button[data-act]",ca).forEach(b=>b.addEventListener("click",()=>onAct(s,b.dataset.act,card)));
  card.appendChild(ca);
  return card;
}

function btn(parent,cls,act,label){
  const b=document.createElement("button"); b.className=cls; b.dataset.act=act; b.textContent=label;
  parent.appendChild(b);
}

async function onAct(s,act,card){
  try{
    if(act==="start"){
      const j=await api(`/api/start/${encodeURIComponent(s.name)}`,{method:"POST"});
      toast(j.result.msg,j.result.ok?"ok":"err"); refresh();
    }else if(act==="stop"){
      const j=await api(`/api/stop/${encodeURIComponent(s.name)}`,{method:"POST"});
      toast(j.result.msg,j.result.ok?"ok":"err"); refresh();
    }else if(act==="stop-ext"){
      const j=await api(`/api/stop-external/${encodeURIComponent(s.name)}`,{method:"POST"});
      toast(j.result.msg,j.result.ok?"ok":"err"); refresh();
    }else if(act==="restart"){
      const b=$("button[data-act=restart]",card);
      if(b){b.disabled=true;b.textContent="重启中…"}
      try{
        const j=await api(`/api/restart/${encodeURIComponent(s.name)}`,{method:"POST"});
        toast(j.result.msg,j.result.ok?"ok":"err"); refresh();
      }finally{
        if(b){b.disabled=false;b.textContent="重启"}
      }
    }else if(act==="logs"){
      openLogs(s.name);
    }else if(act==="open"){
      window.open(`http://127.0.0.1:${s.port}`,"_blank");
    }else if(act==="health"){
      const b=$("button[data-act=health]",card);
      if(b){b.disabled=true; b.textContent="检查中…"}
      try{
        const j=await api(`/api/health/${encodeURIComponent(s.name)}`);
        showHealth(s.name, j.data);
      }finally{
        if(b){b.disabled=false; b.textContent="检查"}
      }
    }
  }catch(e){ toast("请求失败："+e.message,"err"); }
}

function showHealth(name, data){
  $("#hmTitle").textContent = "技术栈检查 · "+name;
  const box=$("#hmBody");
  if(!data.ok){
    box.innerHTML=`<div class="hm-err">连接失败：${data.error||"未知错误"}</div>`;
  }else{
    const bd=data.body||{};
    const d=bd.data||bd;
    const items=(d.stack&&d.stack.items)||[];
    const status=d.status||"ok";
    const uptime=d.uptimeSeconds!=null?fmtUptime(d.uptimeSeconds):"—";
    const rows=items.map(it=>`<tr>
      <td>${it.role||"—"}</td>
      <td>${it.name||"—"}</td>
      <td>${it.version||"—"}</td>
    </tr>`).join("");
    box.innerHTML=`<div class="hmbody">
      <div class="hm-meta">
        <span class="badge ${status==="ok"?"b-ok":"b-err"}">${status}</span>
        <span class="hm-lat">${data.latency_ms}ms</span>
        <span class="hm-lat">运行 ${uptime}</span>
      </div>
      ${rows?`<table class="hm-stack">
        <tr><td>角色</td><td>名称</td><td>版本</td></tr>
        ${rows}
      </table>`:"<div class='hm-err'>后端未返回技术栈信息</div>"}
    </div>`;
  }
  $("#healthModal").classList.add("open");
}
function fmtUptime(s){
  if(s<60) return s+"s";
  if(s<3600) return Math.floor(s/60)+"m "+Math.floor(s%60)+"s";
  return Math.floor(s/3600)+"h "+Math.floor((s%3600)/60)+"m";
}

function openLogs(name){
  logTarget=name;
  $("#logTitle").textContent="日志 · "+name;
  $("#logModal").classList.add("open");
  loadLog();
  if(logTimer) clearInterval(logTimer);
  logTimer=setInterval(()=>{ if($("#logFollow").checked) loadLog(); },2000);
}
function closeLogs(){
  $("#logModal").classList.remove("open");
  logTarget=null;
  if(logTimer){clearInterval(logTimer);logTimer=null}
}
async function loadLog(){
  if(!logTarget) return;
  try{
    const j=await api(`/api/logs/${encodeURIComponent(logTarget)}?n=400`);
    const pre=$("#logPre");
    const atBottom=pre.scrollTop+pre.clientHeight>=pre.scrollHeight-8;
    pre.textContent=j.data.content||"（暂无日志）";
    if(atBottom) pre.scrollTop=pre.scrollHeight;
    $("#logMeta").textContent=`${j.data.n} 行 · ${(j.data.content||"").length} 字符`;
  }catch(e){$("#logPre").textContent="读取失败："+e.message}
}

$("#btnSwitch").addEventListener("click",async()=>{
  const backend=$("#proxySel").value;
  const j=await api("/api/switch",{method:"POST",body:JSON.stringify({backend})});
  toast(j.result.msg,j.result.ok?"ok":"err"); refresh();
});
$("#btnDb").addEventListener("click",async()=>{
  const driver=$("#dbSel").value;
  const j=await api("/api/db-driver",{method:"POST",body:JSON.stringify({driver})});
  toast(j.result.msg,j.result.ok?"ok":"err"); syncDbTabs(driver); refresh();
});
$("#dbSel").addEventListener("change",()=>syncDbTabs($("#dbSel").value));
function syncDbTabs(driver){
  $("#dbTabPg").classList.toggle("active", driver==="postgres");
  $("#dbTabSqlite").classList.toggle("active", driver==="sqlite");
}
$("#btnDbConfig").addEventListener("click",async()=>{
  const body={
    pg_host:$("#pgHost").value, pg_port:$("#pgPort").value,
