# --------------------------------------------------------------
# 子命令：web（启动 :9090 控制台）
# --------------------------------------------------------------
def cmd_web(args) -> int:
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    host = getattr(args, "host", "127.0.0.1")
    port = getattr(args, "port", WEBUI_PORT)

    class Handler(BaseHTTPRequestHandler):
        server_version = "HelloTimePro-DevManager/0.1"

        def log_message(self, fmt, *a):  # 静默
            pass

        def _send_json(self, payload, status=200):
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            try:
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass

        def _send_html(self, html, status=200):
            body = html.encode("utf-8")
            try:
                self.send_response(status)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass

        def _read_body(self):
            n = int(self.headers.get("Content-Length", "0") or "0")
            if n <= 0:
                return {}
            try:
                return json.loads(self.rfile.read(n).decode("utf-8"))
            except Exception:
                return {}

        def do_GET(self):
            u = urlparse(self.path)
            path = u.path.rstrip("/") or "/"
            if path in ("/", "/index.html"):
                self._send_html(WEB_HTML)
                return
            if path == "/api/snapshot":
                self._send_json({"ok": True, "data": op_snapshot()})
                return
            if path.startswith("/api/health/"):
                name = path[len("/api/health/"):]
                self._send_json({"ok": True, "data": op_health(name)})
                return
            if path.startswith("/api/logs/"):
                name = path[len("/api/logs/"):]
                q = parse_qs(u.query)
                n = 200
                try:
                    n = max(10, min(2000, int(q.get("n", ["200"])[0])))
                except ValueError:
                    pass
                self._send_json({"ok": True, "data": {
                    "name": name, "n": n, "content": op_logs(name, n),
                }})
                return
            self._send_json({"ok": False, "msg": "not found"}, 404)

        def do_POST(self):
            u = urlparse(self.path)
            path = u.path.rstrip("/") or "/"
            body = self._read_body()
            if path.startswith("/api/start/"):
                self._send_json({"ok": True, "result": op_start(path[len("/api/start/"):])})
                return
            if path.startswith("/api/stop/"):
                self._send_json({"ok": True, "result": op_stop(path[len("/api/stop/"):])})
                return
            if path.startswith("/api/stop-external/"):
                self._send_json({"ok": True, "result": op_stop_external(path[len("/api/stop-external/"):])})
                return
            if path.startswith("/api/restart/"):
                name = path[len("/api/restart/"):]
                op_stop(name)
                res = op_start(name)
                self._send_json({"ok": True, "result": res})
                return
            if path.startswith("/api/clear-log/"):
                name = path[len("/api/clear-log/"):]
                self._send_json({"ok": True, "result": op_clear_log(name)})
                return
            if path == "/api/switch":
                target = str(body.get("backend", "")).strip()
                self._send_json({"ok": True, "result": op_switch(target)})
                return
            if path == "/api/db-driver":
                drv = str(body.get("driver", "")).strip()
                self._send_json({"ok": True, "result": op_set_db_driver(drv)})
                return
            if path == "/api/db-config":
                self._send_json({"ok": True, "result": op_set_db_config(body)})
                return
            if path == "/api/restart-all":
                state = State.load()
                sweep_dead(state)
                names = list(state.processes.keys())
                results = []
                for n in names:
                    results.append({"name": n, **op_stop(n)})
                for n in names:
                    results.append({"name": n, **op_start(n)})
                self._send_json({"ok": True, "result": {"ok": True, "msg": f"已重启 {len(names)} 个", "results": results}})
                return
            if path == "/api/stop-all":
                state = State.load()
                sweep_dead(state)
                names = list(state.processes.keys())
                results = [{"name": n, **op_stop(n)} for n in names]
                self._send_json({"ok": True, "result": {"ok": True, "msg": f"已停止 {len(names)} 个", "results": results}})
                return
            self._send_json({"ok": False, "msg": "not found"}, 404)

    print(bold("\nHelloTime Pro · Web UI"))
    print(f"  监听: {cyan(f'http://{host}:{port}')}")
    print(dim("  按 Ctrl+C 退出\n"))
    if not getattr(args, "no_open", False):
        try:
            import webbrowser
            webbrowser.open(f"http://{host}:{port}")
        except Exception:
            pass
    try:
        ThreadingHTTPServer((host, port), Handler).serve_forever()
    except KeyboardInterrupt:
        print(dim("\n已退出。"))
        return 0
    except OSError as e:
        print(red(f"启动失败: {e}"))
        if "Address already in use" in str(e):
            print(dim(f"  端口 {port} 被占用，可用 --port 指定其他端口"))
        return 7
    return 0

# --------------------------------------------------------------
# 入口
# --------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hello",
        description="HelloTime Pro · dev-manager",
    )
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("list",        help="列出所有已登记实现").set_defaults(func=cmd_list)
    sub.add_parser("doctor",      help="检查环境依赖").set_defaults(func=cmd_doctor)
    sub.add_parser("status",      help="显示进程状态").set_defaults(func=cmd_status)

    start = sub.add_parser("start", help="启动实现"); start.add_argument("name")
    start.set_defaults(func=cmd_start)

    stop = sub.add_parser("stop",   help="停止实现"); stop.add_argument("name")
    stop.set_defaults(func=cmd_stop)

    sub.add_parser("restart-all", help="重启所有").set_defaults(func=cmd_restart_all)

    sw = sub.add_parser("switch",  help="切换 :9080 代理目标后端")
    sw.add_argument("backend")
    sw.set_defaults(func=cmd_switch)

    lg = sub.add_parser("logs",    help="查看尾部日志")
    lg.add_argument("name")
    lg.add_argument("-n", type=int, default=200, help="行数，默认 200")
    lg.set_defaults(func=cmd_logs)

    web = sub.add_parser("web", help="启动 Web UI 控制台")
    web.add_argument("--host", default="127.0.0.1")
    web.add_argument("--port", type=int, default=WEBUI_PORT)
    web.add_argument("--no-open", action="store_true", help="不自动打开浏览器")
    web.set_defaults(func=cmd_web)
    return p

def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        return cmd_web(args)
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
