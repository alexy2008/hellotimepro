# 桌面 / 移动客户端：纯 API 消费者，复用后端契约（不持有 /api/v1）。
# Web 背书型（electron/tauri）dev 模式拉起内嵌前端的 Vite dev server，
# 探端口即就绪；端口取 7190–7199 段，避开前端 SPA 端口。
# 纯原生型（swiftui / flutter）无 webview、无 dev server 端口 → port=None：
# op_start 跳过端口探测，改以进程存活判就绪；Dart http / URLSession 直连 :9080。
DESKTOP = {
    "electron": {"dir": "desktop/electron",       "port": 7190,  "runtime": "node"},
    "tauri":    {"dir": "desktop/tauri",          "port": 7191,  "runtime": "rust"},
    "swiftui":  {"dir": "desktop/swiftui",        "port": None,  "runtime": "swift"},
    "flutter":  {"dir": "desktop/flutter",        "port": None,  "runtime": "flutter"},
    "qt-pyside": {"dir": "desktop/qt-pyside",     "port": None,  "runtime": "python"},
}

# 移动客户端：纯 API 消费者，复用后端契约。
# react-native（Expo）dev 模式下 `./run` 拉起 Metro dev server（端口 7192），
# 探端口即就绪（同 electron/tauri 模型）；在模拟器上打开 App 是独立动作（./run ios）。
# RN 无 Vite 代理，fetch 直连 :9080（EXPO_PUBLIC_API_BASE 可覆盖）。
# ios（SwiftUI 原生）无 Metro/dev server → port=None：`./run` 编译+装+前台启动模拟器 app，
# 以 run 进程存活判就绪（同 swiftui 桌面端）；URLSession 直连 :9080。
MOBILE = {
    "react-native":   {"dir": "mobile/react-native", "port": 7192, "runtime": "node"},
    "ios":            {"dir": "mobile/ios",          "port": None, "runtime": "xcode"},
    # flutter-mobile 与 desktop/flutter 是同一份工程（一码多端）：mobile/flutter 仅提供移动
    # 运行入口（./run = flutter run -d iOS 模拟器），代码在 ../../desktop/flutter，靠 MediaQuery
    # 宽窄分支切两套 IA。port=None → 前台进程判活（同 ios/桌面 flutter），Dart http 直连 :9080。
    "flutter-mobile": {"dir": "mobile/flutter",      "port": None, "runtime": "flutter"},
}

PROXY_PORT = 9080
WEBUI_PORT = 9090

ALIASES = {
    "spring-boot": "spring",
    "react-ts": "react",
    "vue3-ts": "vue",
    "svelte-ts": "svelte",
    "solid-ts": "solid",
}

# --------------------------------------------------------------
# 终端颜色（无依赖，支持 NO_COLOR）
# --------------------------------------------------------------
NO_COLOR = bool(os.environ.get("NO_COLOR")) or not sys.stdout.isatty()

def c(code: str, s: str) -> str:
    if NO_COLOR:
        return s
    return f"\033[{code}m{s}\033[0m"

def green(s):  return c("32", s)
def red(s):    return c("31", s)
def yellow(s): return c("33", s)
def dim(s):    return c("2",  s)
def bold(s):   return c("1",  s)
def cyan(s):   return c("36", s)

def _fmt_kb(kb: int | None) -> str:
    if kb is None:
        return "-"
    if kb < 1024:
        return f"{kb}K"
    mb = kb / 1024
    if mb < 1024:
        return f"{mb:.1f}M"
    return f"{mb / 1024:.2f}G"

# --------------------------------------------------------------
# 实现登记
# --------------------------------------------------------------
def all_stacks() -> dict:
    """返回 name -> {dir, port, runtime, kind}。"""
    merged = {}
    for k, v in BACKENDS.items():
        merged[k] = {**v, "kind": "backend"}
    for k, v in FRONTENDS.items():
        merged[k] = {**v, "kind": "frontend"}
    for k, v in FULLSTACKS.items():
        merged[k] = {**v, "kind": "fullstack"}
    for k, v in DESKTOP.items():
        merged[k] = {**v, "kind": "desktop"}
    for k, v in MOBILE.items():
        merged[k] = {**v, "kind": "mobile"}
    return merged

def canonical_name(name: str) -> str:
    return ALIASES.get(name, name)

def resolve_stack(name: str) -> Optional[dict]:
    name = canonical_name(name)
    stacks = all_stacks()
    if name in stacks:
        return {"name": name, **stacks[name]}
    print(red(f"未知实现: {name}"))
    print(dim("可用实现见 `hello list`"))
    return None

# --------------------------------------------------------------
# 状态文件
# --------------------------------------------------------------
@dataclass
class ProcessRecord:
    name: str
    pid: int
    port: int
    started_at: float
    log: str

@dataclass
class DbConfig:
    pg_host: str = "127.0.0.1"
    pg_port: int = 55432
    pg_db:   str = "hellotime_pro"
    pg_user: str = "hellotime"
    pg_pass: str = "hellotime"
    sqlite_path: str = "data/sqlite/hellotime.db"

@dataclass
class LlmConfig:
    enabled: bool = False
    provider: str = "openai"
    base_url: str = "https://api.openai.com/v1"
    api_key: str = ""
    model: str = "gpt-4.1-mini"
    timeout_ms: int = 30000

@dataclass
class State:
    processes: dict = field(default_factory=dict)  # name -> ProcessRecord
    proxy_target: Optional[str] = None             # 当前 :9080 指向的 backend name
    proxy_pid: Optional[int] = None                # :9080 代理进程 PID
    db_driver: str = "postgres"
    db_config: DbConfig = field(default_factory=DbConfig)
    llm_config: LlmConfig = field(default_factory=LlmConfig)

    def save(self):
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        data = {
            "processes": {k: asdict(v) for k, v in self.processes.items()},
            "proxy_target": self.proxy_target,
            "proxy_pid": self.proxy_pid,
            "db_driver": self.db_driver,
            "db_config": asdict(self.db_config),
            "llm_config": asdict(self.llm_config),
        }
        STATE_FILE.write_text(json.dumps(data, indent=2, ensure_ascii=False))

    @classmethod
    def load(cls) -> "State":
        if not STATE_FILE.exists():
            return cls()
        try:
            raw = json.loads(STATE_FILE.read_text())
            procs = {k: ProcessRecord(**v) for k, v in raw.get("processes", {}).items()}
            raw_cfg = raw.get("db_config", {})
            cfg = DbConfig(**{k: v for k, v in raw_cfg.items() if k in DbConfig.__dataclass_fields__})
            raw_llm = raw.get("llm_config", {})
            llm = LlmConfig(**{k: v for k, v in raw_llm.items() if k in LlmConfig.__dataclass_fields__})
            return cls(
                processes=procs,
                proxy_target=raw.get("proxy_target"),
                proxy_pid=raw.get("proxy_pid"),
                db_driver=raw.get("db_driver", "postgres"),
                db_config=cfg,
                llm_config=llm,
            )
        except Exception as e:
            print(yellow(f"⚠ 状态文件损坏（{e}），重置。"))
            return cls()

def _sqlite_path_for(target: str | None, base: str) -> str:
    """
    把 `<base_dir>/hellotime.db` 派生为 `<base_dir>/hellotime-<target>.db`。

    约定：每个实现独占一份 SQLite 文件，避免 schema/data 混入相互踩。
    state.db_config.sqlite_path 仅作"基名/模板"。
    """
    if target:
        d, fname = os.path.split(base)
        name, ext = os.path.splitext(fname)
        fname = f"{name}-{target}{ext}"
        base = os.path.join(d, fname) if d else fname
    if not os.path.isabs(base):
        base = str(ROOT / base)
    return base

def _build_db_url(driver: str, cfg: DbConfig, target: str | None = None) -> str:
    if driver == "sqlite":
        path = _sqlite_path_for(target, cfg.sqlite_path)
        return f"sqlite:///{path}"
    return f"postgresql://{cfg.pg_user}:{cfg.pg_pass}@{cfg.pg_host}:{cfg.pg_port}/{cfg.pg_db}"

def _pid_stat(pid: int) -> str:
    try:
        out = subprocess.run(
            ["ps", "-o", "stat=", "-p", str(pid)],
            capture_output=True,
            text=True,
            timeout=1,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except Exception:
        pass
    return ""

def is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (OSError, ProcessLookupError):
        return False
    stat = _pid_stat(pid)
    if stat and "Z" in stat[:3]:
        return False
    return True

def _tcp_probe(port: int | None, host: str = "127.0.0.1", timeout: float = 0.25) -> bool:
    if port is None:
        return False
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except Exception:
        return False

def wait_for_port(port: int | None, *, timeout: float = 15.0, host: str = "127.0.0.1") -> bool:
    deadline = time.time() + max(0.0, timeout)
    while time.time() <= deadline:
        if _tcp_probe(port, host=host, timeout=0.2):
            return True
        time.sleep(0.2)
    return _tcp_probe(port, host=host, timeout=0.2)

def _process_table() -> dict[int, dict]:
    """Return pid -> {pgid, cpu_percent, rss_kb, stat} from a single ps scan."""
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,pgid=,%cpu=,rss=,stat="],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except Exception:
        return {}
    rows = {}
    for line in out.stdout.splitlines():
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        try:
            pid = int(parts[0])
            rows[pid] = {
                "pgid": int(parts[1]),
                "cpu_percent": float(parts[2]),
                "rss_kb": int(parts[3]),
                "stat": parts[4],
            }
        except ValueError:
            continue
    return rows

def _listener_pids(port: int | None) -> list[int]:
    if port is None:
        return []
    try:
        out = subprocess.run(
            ["lsof", "-ti", f"TCP:{port}", "-sTCP:LISTEN"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        return [int(p) for p in out.stdout.split() if p.strip().isdigit()]
    except Exception:
        return []

def _resource_usage_for_pid(pid: int | None, proc_table: dict[int, dict]) -> dict:
    if pid is None or pid not in proc_table:
        return {"cpu_percent": None, "memory_rss_kb": None, "process_count": 0}
    root = proc_table[pid]
    pgid = root["pgid"]
    members = [
        row for row in proc_table.values()
        if row["pgid"] == pgid and "Z" not in row["stat"][:3]
    ]
    return {
        "cpu_percent": round(sum(row["cpu_percent"] for row in members), 1),
        "memory_rss_kb": sum(row["rss_kb"] for row in members),
        "process_count": len(members),
    }

def _resource_usage_for_port(port: int | None, proc_table: dict[int, dict]) -> dict:
    pids = _listener_pids(port)
    if not pids:
        return {"cpu_percent": None, "memory_rss_kb": None, "process_count": 0}
    seen_pgids = set()
    cpu = 0.0
    rss = 0
    count = 0
    for pid in pids:
        if pid not in proc_table:
            continue
        pgid = proc_table[pid]["pgid"]
        if pgid in seen_pgids:
            continue
        seen_pgids.add(pgid)
        usage = _resource_usage_for_pid(pid, proc_table)
        if usage["cpu_percent"] is not None:
            cpu += usage["cpu_percent"]
            rss += usage["memory_rss_kb"] or 0
            count += usage["process_count"]
    return {
        "cpu_percent": round(cpu, 1) if count else None,
        "memory_rss_kb": rss if count else None,
        "process_count": count,
    }

def sweep_dead(state: State) -> None:
    """清理已死亡进程。"""
    dead = [name for name, p in state.processes.items() if not is_alive(p.pid)]
    for name in dead:
        del state.processes[name]
    proxy_dead = state.proxy_pid is not None and not is_alive(state.proxy_pid)
    if proxy_dead:
        state.proxy_pid = None
    if dead or proxy_dead:
        state.save()

# --------------------------------------------------------------
# 子命令：list
# --------------------------------------------------------------
def cmd_list(args) -> int:
    stacks = all_stacks()
    print(bold("\n已登记实现（共 %d）\n" % len(stacks)))
    header = f"  {'name':<12} {'kind':<10} {'port':<6} {'runtime':<8} {'dir'}"
    print(dim(header))
    print(dim("  " + "-" * (len(header) - 2)))
    for name, info in sorted(stacks.items(),
                             key=lambda x: (x[1]["kind"], x[1]["port"] if x[1]["port"] is not None else 99999)):
        exists = (ROOT / info["dir"]).exists()
        mark = green("●") if exists else dim("○")
        port_s = str(info["port"]) if info["port"] is not None else "-"
        print(f"  {mark} {name:<10} {info['kind']:<10} {port_s:<6} {info['runtime']:<8} {info['dir']}")
    print()
    print(dim("  ● = 目录存在    ○ = 暂未实现"))
    return 0

# --------------------------------------------------------------
# 子命令：doctor
# --------------------------------------------------------------
def probe(cmd: str, *, version_flag: str = "--version") -> tuple[bool, str]:
    exe = shutil.which(cmd)
    if not exe:
        return False, ""
    try:
        out = subprocess.run(
            [exe, version_flag],
            capture_output=True, text=True, timeout=4,
        )
        text = out.stdout + out.stderr
        # 回退到无 flag 的形式（Go 等工具用 `go version`）
        if out.returncode != 0 or "not defined" in text:
            out = subprocess.run(
                [exe, "version"],
                capture_output=True, text=True, timeout=4,
            )
            text = out.stdout + out.stderr
        ver = text.splitlines()[0] if text else "(无版本输出)"
        return True, ver.strip()[:80]
    except Exception:
        return True, "(无法读取版本)"

def cmd_doctor(args) -> int:
    checks = [
        ("Python 3",    "python3"),
        ("Node.js",     "node"),
        ("Bun",         "bun"),
        ("Go",          "go"),
        ("Rust (cargo)", "cargo"),
        ("JDK (javac)", "javac"),
        ("Kotlin",      "kotlinc"),
        ("Swift",       "swift"),
        (".NET SDK",    "dotnet"),
        ("Ruby",        "ruby"),
        ("PHP",         "php"),
        ("CMake",       "cmake"),
        ("Flutter",     "flutter"),
        ("XcodeGen",    "xcodegen"),
        ("psql",        "psql"),
    ]
    print(bold("\n环境依赖检查\n"))
    ok_count = 0
    for label, cmd in checks:
        ok, ver = probe(cmd)
        if ok:
            ok_count += 1
            print(f"  {green('✓')} {label:<16} {dim(ver)}")
        else:
            print(f"  {yellow('○')} {label:<16} {dim('未安装（仅在要跑对应栈时需要）')}")

    # 当前数据库配置可达性。PostgreSQL 由本机配置管理，不默认探测 Docker。
    print()
    state = State.load()
    db_ok = False
    if state.db_driver == "sqlite":
        sqlite_path = Path(_sqlite_path_for(None, state.db_config.sqlite_path))
        try:
            sqlite_path.parent.mkdir(parents=True, exist_ok=True)
            db_ok = sqlite_path.parent.exists() and os.access(sqlite_path.parent, os.W_OK)
        except Exception:
            db_ok = False
        mark = green("✓") if db_ok else red("✗")
        detail = str(sqlite_path.relative_to(ROOT)) if sqlite_path.is_relative_to(ROOT) else str(sqlite_path)
        print(f"  {mark} {'SQLite 路径':<16} {dim(detail)}")
    else:
        cfg = state.db_config
        db_ok = _tcp_probe(cfg.pg_port, host=cfg.pg_host, timeout=1.0)
        mark = green("✓") if db_ok else red("✗")
        detail = f"{cfg.pg_host}:{cfg.pg_port}/{cfg.pg_db} user={cfg.pg_user}"
        print(f"  {mark} {'PostgreSQL 连接':<16} {dim(detail)}")
        if not db_ok:
            print(dim("    请在 Web UI 或 data/.hello-state.json 中确认本机 PostgreSQL 连接配置。"))

    # 目录检查
    print()
    for sub in ["spec", "ui-prototype", "data"]:
        p = ROOT / sub
        if p.exists():
            print(f"  {green('✓')} {'目录 ' + sub:<16} {dim(str(p.relative_to(ROOT)))}")
        else:
            print(f"  {red('✗')} {'目录 ' + sub:<16} {dim('缺失')}")

    print()
    print(dim(f"  通过: {ok_count}/{len(checks)} 基础工具 + DB={'✓' if db_ok else '✗'}"))
    print()
    return 0 if ok_count >= 2 and db_ok else 1

# --------------------------------------------------------------
# 子命令：status
# --------------------------------------------------------------
def cmd_status(args) -> int:
    snap = op_snapshot()

    print(bold("\n当前状态\n"))
    active = [s for s in snap["stacks"] if s["running"] or s["port_open"]]
    if not active:
        print(dim("  （没有正在运行的实现）"))
    else:
        print(dim(f"  {'name':<12} {'state':<10} {'pid':<8} {'port':<6} {'cpu':<7} {'mem':<8} {'uptime'}"))
        print(dim("  " + "-" * 80))
        for s in active:
            dur = s["uptime_s"]
            uptime = f"{dur // 3600}h{(dur % 3600) // 60}m{dur % 60}s" if s["running"] else "-"
            label = {
                "ready": green("ready"),
                "starting": yellow("starting"),
                "external": yellow("external"),
            }.get(s["status"], dim(s["status"]))
            pid = s["pid"] if s["pid"] is not None else "-"
            if s["port"] is None:
                port = "native"
            else:
                port = f":{s['port']}" if s["port_open"] else f":{s['port']}?"
            cpu = f"{s['cpu_percent']:.1f}%" if s.get("cpu_percent") is not None else "-"
            mem = _fmt_kb(s.get("memory_rss_kb"))
            print(f"  {s['name']:<12} {label:<10} {str(pid):<8} {port:<6} {cpu:<7} {mem:<8} {uptime}")

    print()
    proxy = snap["proxy"]
    if proxy["target"]:
        proxy_state = green("可用") if proxy["ok"] else yellow("不可用")
        target = f"{proxy['target']}(:{proxy['target_port']})"
        print(f"  :{PROXY_PORT} 代理指向：{cyan(target)}  {proxy_state}")
    else:
        print(f"  :{PROXY_PORT} 代理指向：{cyan('（未设置）')}")
    print(f"  DB_DRIVER   = {cyan(snap['db_driver'])}")
    print(f"  Web UI      = http://127.0.0.1:{WEBUI_PORT}  {dim('(hello web 启动)')}")
    print()
    return 0

# --------------------------------------------------------------
# 核心操作（CLI 与 Web 共用）
# --------------------------------------------------------------
def op_start(name: str) -> dict:
    """启动一个实现，返回 {ok, code, msg, pid?, port?}。"""
    requested = name
    name = canonical_name(name)
    stacks = all_stacks()
    if name not in stacks:
        return {"ok": False, "code": 2, "msg": f"未知实现: {requested}"}
    info = stacks[name]
    state = State.load()
    sweep_dead(state)

    if name in state.processes:
        p = state.processes[name]
        # 纯原生桌面端 port=None：以进程存活判就绪，不能用端口探测（否则恒为未就绪）
        ready = is_alive(p.pid) if p.port is None else _tcp_probe(p.port)
        msg = f"已经在运行 pid={p.pid}"
        if not ready:
            msg += "（端口未就绪）" if p.port is not None else "（进程已退出）"
        return {"ok": True, "code": 0, "msg": msg,
                "pid": p.pid, "port": p.port, "already": True, "ready": ready}

    stack_dir = ROOT / info["dir"]
    if not stack_dir.exists():
        return {"ok": False, "code": 3,
                "msg": f"目录不存在: {info['dir']}（该栈还未实现）"}

    run_script = stack_dir / "run"
    if not run_script.exists():
        return {"ok": False, "code": 4,
                "msg": f"缺少启动脚本: {info['dir']}/run"}

    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"{name}.log"
    log_f = log_path.open("a", buffering=1)
    log_f.write(f"\n\n=== start at {time.strftime('%Y-%m-%d %H:%M:%S')} ===\n")

    try:
        llm = state.llm_config
        db_driver = os.environ.get("DB_DRIVER") or state.db_driver
        db_url = os.environ.get("DB_URL") or _build_db_url(db_driver, state.db_config, name)
        proc = subprocess.Popen(
            ["./run"],
            cwd=stack_dir,
            stdout=log_f,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            env={**os.environ,
                 "DB_DRIVER": db_driver,
                 "DB_URL": db_url,
                 "LLM_ENABLED": "true" if llm.enabled else "false",
                 "LLM_PROVIDER": llm.provider,
                 "LLM_BASE_URL": llm.base_url,
                 "LLM_API_KEY": llm.api_key,
                 "LLM_MODEL": llm.model,
                 "LLM_TIMEOUT_MS": str(llm.timeout_ms)},
        )
    except Exception as e:
        return {"ok": False, "code": 5, "msg": f"启动失败: {e}"}

    rec = ProcessRecord(
        name=name, pid=proc.pid, port=info["port"],
        started_at=time.time(), log=str(log_path),
    )
    state.processes[name] = rec
    state.save()
    if info["port"] is None:
        # 纯原生目标（如 swiftui）：无 dev server 端口，跳过端口探测，
        # 以进程存活判就绪（run 脚本先 swift build 再前台 exec，全程进程在）。
        time.sleep(1.0)
        ready = is_alive(proc.pid)
        if not ready:
            state = State.load()
            sweep_dead(state)
            return {"ok": False, "code": 8,
                    "msg": f"{name} 启动进程已退出；请查看日志",
                    "pid": proc.pid, "port": None, "ready": False}
        return {"ok": True, "code": 0,
                "msg": f"已启动 {name} pid={proc.pid}（原生窗口，首次需编译稍候）",
                "pid": proc.pid, "port": None, "ready": True}

    try:
        wait_seconds = float(os.environ.get("HELLO_START_WAIT_SECONDS", "15"))
    except ValueError:
        wait_seconds = 15.0
    ready = wait_for_port(info["port"], timeout=wait_seconds)
    if not ready and not is_alive(proc.pid):
        state = State.load()
        sweep_dead(state)
        return {"ok": False, "code": 8,
                "msg": f"{name} 启动进程已退出，端口 :{info['port']} 未监听；请查看日志",
                "pid": proc.pid, "port": info["port"], "ready": False}
    msg = f"已启动 {name} pid={proc.pid} port={info['port']}"
    if not ready:
        msg += "（进程仍在启动，端口暂未就绪）"
    return {"ok": True, "code": 0,
            "msg": msg,
            "pid": proc.pid, "port": info["port"], "ready": ready}

def op_stop(name: str) -> dict:
    requested = name
    name = canonical_name(name)
    if name not in all_stacks():
        return {"ok": False, "code": 2, "msg": f"未知实现: {requested}"}
    state = State.load()
    sweep_dead(state)
    if name not in state.processes:
        return {"ok": True, "code": 0, "msg": f"{name} 不在运行中"}
    p = state.processes[name]
    try:
        os.killpg(os.getpgid(p.pid), signal.SIGTERM)
        for _ in range(50):
            if not is_alive(p.pid):
                break
            time.sleep(0.1)
        if is_alive(p.pid):
            os.killpg(os.getpgid(p.pid), signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError as e:
        return {"ok": False, "code": 6, "msg": f"无法杀进程 {p.pid}: {e}"}
    del state.processes[name]
    state.save()
    return {"ok": True, "code": 0, "msg": f"已停止 {name}"}

def op_stop_external(name: str) -> dict:
    """Kill the process listening on the stack's port (externally-started service)."""
    name = canonical_name(name)
    stacks = all_stacks()
    if name not in stacks:
        return {"ok": False, "code": 2, "msg": f"未知实现: {name}"}
    port = stacks[name]["port"]
    try:
        out = subprocess.run(
            ["lsof", "-ti", f"TCP:{port}"],
            capture_output=True, text=True, timeout=3,
        )
        pids = [int(p) for p in out.stdout.split() if p.strip().isdigit()]
    except Exception as e:
        return {"ok": False, "code": 7, "msg": f"lsof 失败: {e}"}
    if not pids:
        return {"ok": True, "code": 0, "msg": f"端口 {port} 无进程监听"}
    killed = []
    for pid in pids:
        try:
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
            except (ProcessLookupError, OSError):
                os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not is_alive(pid):
                    break
                time.sleep(0.1)
            if is_alive(pid):
                os.kill(pid, signal.SIGKILL)
            killed.append(pid)
        except PermissionError as e:
            return {"ok": False, "code": 6, "msg": f"无权 kill pid {pid}: {e}"}
        except ProcessLookupError:
            killed.append(pid)
    # 如果该进程之前也被 hello 管理（不寻常但可能），清一下状态
    state = State.load()
    if name in state.processes:
        del state.processes[name]
        state.save()
    return {"ok": True, "code": 0, "msg": f"已停止 {name}（pid {killed}）"}

_PROXY_SCRIPT = """
import socket, threading, sys

target_port = int(sys.argv[1])

def pipe(src, dst):
    try:
        while True:
            d = src.recv(4096)
            if not d:
                break
            dst.sendall(d)
    except Exception:
        pass
    finally:
        for s in (src, dst):
            try: s.close()
            except Exception: pass

srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('0.0.0.0', {proxy_port}))
srv.listen(128)
while True:
    c, _ = srv.accept()
    try:
        b = socket.create_connection(('127.0.0.1', target_port), timeout=None)
        threading.Thread(target=pipe, args=(c, b), daemon=True).start()
        threading.Thread(target=pipe, args=(b, c), daemon=True).start()
    except Exception:
        c.close()
"""

def _kill_proxy_pid(pid: Optional[int]) -> None:
    """Kill a proxy process by PID (best-effort)."""
    if pid is None:
        return
    try:
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except (ProcessLookupError, OSError):
            os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not is_alive(pid):
                break
            time.sleep(0.05)
        if is_alive(pid):
            os.kill(pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass

def _kill_port(port: int) -> None:
    """Kill whatever process is listening on port (best-effort, handles orphans)."""
    try:
        out = subprocess.run(
            ["lsof", "-ti", f"TCP:{port}"],
            capture_output=True, text=True, timeout=3,
        )
        for p in out.stdout.split():
            if p.strip().isdigit():
                _kill_proxy_pid(int(p))
    except Exception:
        pass

def _start_proxy(target_port: int) -> dict:
    """Start a Python TCP proxy on PROXY_PORT → target_port."""
    script = _PROXY_SCRIPT.format(proxy_port=PROXY_PORT)
    proc = subprocess.Popen(
        [sys.executable, "-c", script, str(target_port)],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if wait_for_port(PROXY_PORT, timeout=2.0):
        return {"ok": True, "pid": proc.pid}
    if not is_alive(proc.pid):
        return {"ok": False, "pid": proc.pid, "msg": f"代理进程已退出，未能监听 :{PROXY_PORT}"}
    return {"ok": False, "pid": proc.pid, "msg": f"代理未能监听 :{PROXY_PORT}"}

def op_switch(backend: str) -> dict:
    requested = backend
    backend = canonical_name(backend)
    if backend not in BACKENDS:
        return {"ok": False, "code": 2, "msg": f"未知后端: {requested}"}
    target_port = BACKENDS[backend]["port"]
    state = State.load()
    # Kill existing proxy (tracked PID first, then sweep the port for orphans)
    _kill_proxy_pid(state.proxy_pid)
    _kill_port(PROXY_PORT)
    proxy = _start_proxy(target_port)
    if not proxy["ok"]:
        _kill_proxy_pid(proxy.get("pid"))
        state.proxy_pid = None
        state.save()
        return {"ok": False, "code": 7, "msg": proxy.get("msg", "代理启动失败")}
    pid = proxy["pid"]
    state.proxy_target = backend
    state.proxy_pid = pid
    state.save()
    target_ready = _tcp_probe(target_port)
    suffix = "" if target_ready else "；目标后端当前未监听"
    return {"ok": True, "code": 0,
            "msg": f":{PROXY_PORT} → {backend} (:{target_port})，代理 pid={pid}{suffix}",
            "pid": pid, "target_port": target_port, "target_ready": target_ready}

def op_set_db_driver(driver: str) -> dict:
    if driver not in ("postgres", "sqlite"):
        return {"ok": False, "code": 2, "msg": f"未知 DB_DRIVER: {driver}"}
    state = State.load()
    state.db_driver = driver
    state.save()
    return {"ok": True, "code": 0, "msg": f"DB_DRIVER = {driver}（重启已运行的服务后生效）"}

def op_set_db_config(cfg: dict) -> dict:
    state = State.load()
    c = state.db_config
    for k in ("pg_host", "pg_db", "pg_user", "sqlite_path"):
        if k in cfg and cfg[k] is not None:
            setattr(c, k, str(cfg[k]).strip())
    if _truthy(cfg.get("clear_pg_pass", False)):
        c.pg_pass = ""
    elif "pg_pass" in cfg and cfg["pg_pass"] is not None:
        # 空值表示 UI 里“留空保持不变”，避免每次 snapshot 泄露或清空密码。
        pwd = str(cfg["pg_pass"])
        if pwd:
            c.pg_pass = pwd
    if "pg_port" in cfg:
        try:
            c.pg_port = int(cfg["pg_port"])
        except (ValueError, TypeError):
            return {"ok": False, "code": 2, "msg": "pg_port 必须是数字"}
    state.save()
    return {"ok": True, "code": 0, "msg": "数据库连接已保存（重启服务后生效）"}

def _truthy(v) -> bool:
    if isinstance(v, bool):
        return v
    return str(v).strip().lower() in ("1", "true", "yes", "on")

def op_set_llm_config(cfg: dict) -> dict:
    state = State.load()
    c = state.llm_config
    if "enabled" in cfg:
        c.enabled = _truthy(cfg["enabled"])
    for k in ("provider", "base_url", "model"):
        if k in cfg and cfg[k] is not None:
            val = str(cfg[k]).strip()
            if val:
                setattr(c, k, val)
    if "api_key" in cfg and cfg["api_key"] is not None:
        key = str(cfg["api_key"]).strip()
        if key:
            c.api_key = key
    if "timeout_ms" in cfg:
        try:
            c.timeout_ms = max(1000, min(60000, int(cfg["timeout_ms"])))
        except (ValueError, TypeError):
            return {"ok": False, "code": 2, "msg": "LLM_TIMEOUT_MS 必须是数字"}
    state.save()
    return {"ok": True, "code": 0, "msg": "大模型配置已保存（重启服务后生效）"}

def op_logs(name: str, n: int = 200) -> str:
    name = canonical_name(name)
    log_path = LOG_DIR / f"{name}.log"
    if not log_path.exists():
        return ""
    with log_path.open("rb") as f:
        f.seek(0, 2)
        size = f.tell()
        # 取最近 ~64KB，足够覆盖几百行
        back = min(size, 65536)
        f.seek(size - back)
        text = f.read().decode("utf-8", errors="replace")
    lines = text.splitlines()[-n:]
    return "\n".join(lines)

def op_clear_log(name: str) -> dict:
    name = canonical_name(name)
    log_path = LOG_DIR / f"{name}.log"
    try:
        log_path.write_text("", encoding="utf-8")
        return {"ok": True, "msg": f"已清空 {name} 日志"}
    except Exception as e:
        return {"ok": False, "msg": str(e)}

# --------------------------------------------------------------
# 子命令：start / stop / restart-all
# --------------------------------------------------------------
def cmd_start(args) -> int:
    code = 0
    for requested in args.names:
        name = canonical_name(requested)
        res = op_start(requested)
        if not res["ok"]:
            print(red(res["msg"]))
            if res["code"] == 2:
                print(dim("可用实现见 `hello list`"))
            elif res["code"] == 3:
                print(dim("该栈还未实现，无法启动。"))
            elif res["code"] == 4:
                print(dim("按约定每个实现需提供可执行的 ./run 脚本。"))
            code = res["code"] or 1
            continue
        if res.get("already") or not res.get("ready", True):
            print(yellow(res["msg"]))
        else:
            print(green(f"✓ {res['msg']}"))
        print(dim(f"  日志: tail -f data/logs/{name}.log"))
    return code

def cmd_stop(args) -> int:
    code = 0
    for name in args.names:
        res = op_stop(name)
        if not res["ok"]:
            print(red(res["msg"]))
            code = res["code"] or 1
            continue
        if "已停止" in res["msg"]:
            print(green(f"✓ {res['msg']}"))
        else:
            print(dim(res["msg"]))
    return code

def cmd_stop_external(args) -> int:
    code = 0
    for name in args.names:
        res = op_stop_external(name)
        if not res["ok"]:
            print(red(res["msg"]))
            code = res["code"] or 1
        else:
            print(green(f"✓ {res['msg']}"))
    return code

def cmd_restart_all(args) -> int:
    state = State.load()
    sweep_dead(state)
    names = list(state.processes.keys())
    if not names:
        print(dim("（没有正在运行的实现）"))
        return 0
    for name in names:
        cmd_stop(argparse.Namespace(names=[name]))
    for name in names:
        cmd_start(argparse.Namespace(names=[name]))
    return 0

# --------------------------------------------------------------
# 子命令：switch
# --------------------------------------------------------------
def cmd_switch(args) -> int:
    res = op_switch(args.backend)
    if not res["ok"]:
        print(red(res["msg"]))
        print(dim("可选: " + ", ".join(BACKENDS.keys())))
        return res["code"]
    print(green(f"✓ {res['msg']}"))
    return 0

# --------------------------------------------------------------
# 子命令：logs
# --------------------------------------------------------------
def cmd_logs(args) -> int:
    name = canonical_name(args.name)
    log_path = LOG_DIR / f"{name}.log"
    if not log_path.exists():
        print(dim(f"没有日志文件: {log_path.relative_to(ROOT)}"))
        return 0
    text = op_logs(name, args.n)
    if text:
        print(text)
    return 0

# --------------------------------------------------------------
# Web 健康探测与快照
# --------------------------------------------------------------
def op_health(name: str, timeout: float = 3.0) -> dict:
    """调用实现的 /api/v1/health 端点，返回技术栈信息。"""
    from urllib.request import urlopen
    from urllib.error import URLError, HTTPError
    name = canonical_name(name)
    stacks = all_stacks()
    if name not in stacks:
        return {"ok": False, "error": "未知实现"}
    port = stacks[name]["port"]
    t0 = time.time()
    try:
        with urlopen(f"http://127.0.0.1:{port}/api/v1/health", timeout=timeout) as r:
            body = json.loads(r.read().decode("utf-8"))
            health = body.get("data") if isinstance(body, dict) and "data" in body else body
            return {
                "ok": True,
                "latency_ms": int((time.time() - t0) * 1000),
                "body": body,
                "health": health,
            }
    except (HTTPError, URLError, OSError) as e:
        return {"ok": False, "error": str(e)}

def op_snapshot() -> dict:
    """构造 web 前端轮询用的快照。并发 TCP 探活，识别外部启动的服务。"""
    from concurrent.futures import ThreadPoolExecutor

    state = State.load()
    sweep_dead(state)
    stacks = all_stacks()
    now = time.time()
    proc_table = _process_table()

    stack_list = list(stacks.items())
    with ThreadPoolExecutor(max_workers=len(stack_list)) as ex:
        port_open_map = dict(zip(
            [n for n, _ in stack_list],
            ex.map(lambda x: _tcp_probe(x[1]["port"]), stack_list),
        ))

    items = []
    for name, info in stack_list:
        rec = state.processes.get(name)
        stack_dir = ROOT / info["dir"]
        running = rec is not None
        port_open = port_open_map.get(name, False)
        native = info["port"] is None  # 纯原生：无端口可探，进程在即就绪
        if running and (port_open or native):
            status = "ready"
        elif running:
            status = "starting"
        elif port_open:
            status = "external"
        else:
            status = "stopped"
        usage = (
            _resource_usage_for_pid(rec.pid, proc_table)
            if rec
            else _resource_usage_for_port(info["port"], proc_table) if port_open else
            {"cpu_percent": None, "memory_rss_kb": None, "process_count": 0}
        )
        items.append({
            "name": name,
            "kind": info["kind"],
            "port": info["port"],
            "runtime": info["runtime"],
            "dir": info["dir"],
            "implemented": stack_dir.exists() and (stack_dir / "run").exists(),
            "running": running,
            "ready": running and (port_open or native),
            "external": (not running) and port_open,
            "status": status,
            "port_open": port_open,
            "pid": rec.pid if rec else None,
            "started_at": rec.started_at if rec else None,
            "uptime_s": int(now - rec.started_at) if rec else 0,
            "cpu_percent": usage["cpu_percent"],
            "memory_rss_kb": usage["memory_rss_kb"],
            "process_count": usage["process_count"],
        })
    llm = state.llm_config
    db = state.db_config
    proxy_target = state.proxy_target
    proxy_target_info = stacks.get(proxy_target) if proxy_target else None
    proxy_target_port = proxy_target_info["port"] if proxy_target_info else None
    proxy_port_open = _tcp_probe(PROXY_PORT)
    proxy_target_open = _tcp_probe(proxy_target_port)
    proxy_pid_alive = state.proxy_pid is not None and is_alive(state.proxy_pid)
    return {
        "stacks": items,
        "proxy_target": proxy_target,
        "proxy_port": PROXY_PORT,
        "proxy": {
            "target": proxy_target,
            "target_port": proxy_target_port,
            "target_port_open": proxy_target_open,
            "port": PROXY_PORT,
            "port_open": proxy_port_open,
            "pid": state.proxy_pid,
            "pid_alive": proxy_pid_alive,
            "ok": proxy_port_open and proxy_target_open,
        },
        "db_driver": state.db_driver,
        "db_config": {
            "pg_host": db.pg_host,
            "pg_port": db.pg_port,
            "pg_db": db.pg_db,
            "pg_user": db.pg_user,
            "pg_pass_configured": bool(db.pg_pass),
            "sqlite_path": db.sqlite_path,
        },
        "llm_config": {
            "enabled": llm.enabled,
            "provider": llm.provider,
            "base_url": llm.base_url,
            "model": llm.model,
            "timeout_ms": llm.timeout_ms,
            "api_key_configured": bool(llm.api_key),
        },
        "now": now,
    }

# --------------------------------------------------------------
# Web UI HTML（从同目录 hello-ui.html 读取；回退到内嵌空页面）
# --------------------------------------------------------------
def _load_web_html() -> str:
    """运行时读取 hello-ui.html，文件不存在时返回一个简易提示页。"""
    candidate = HERE / "hello-ui.html"
    if candidate.exists():
        try:
            return candidate.read_text(encoding="utf-8")
        except Exception as e:
            pass  # fall through to fallback
    # ── fallback：文件丢失时给出明确提示，而非白屏 ──
    return (
        '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/>'
        '<title>HelloTime Pro · dev-manager</title>'
        '<style>body{font-family:sans-serif;background:#0e0e1c;color:#f5f5fa;'
        'display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0}'
        '.box{text-align:center;padding:40px}</style></head><body>'
        '<div class="box"><h2>&#x26A0; UI 文件缺失</h2>'
        '<p>找不到 <code>scripts/hello-ui.html</code>，请检查仓库完整性。</p></div>'
        '</body></html>'
    )

# --------------------------------------------------------------
# 子命令：web（启动 :9090 控制台）
# --------------------------------------------------------------
def cmd_web(args) -> int:
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    host = getattr(args, "host", "127.0.0.1")
    port = getattr(args, "port", WEBUI_PORT)

    class Handler(BaseHTTPRequestHandler):
        server_version = "HelloTimePro-DevManager/0.1"

        def log_message(self, fmt, *a):  # 静默
            pass

        def _send_json(self, payload, status=200):
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            try:
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass

        def _send_html(self, html, status=200):
            body = html.encode("utf-8")
            try:
                self.send_response(status)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass

        def _send_static(self, file_path: Path, content_type: str):
            try:
                body = file_path.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass
            except Exception:
                self._send_json({"ok": False, "msg": "not found"}, 404)

        def _read_body(self):
            n = int(self.headers.get("Content-Length", "0") or "0")
            if n <= 0:
                return {}
            try:
                return json.loads(self.rfile.read(n).decode("utf-8"))
            except Exception:
                return {}

        def do_GET(self):
            u = urlparse(self.path)
            path = u.path.rstrip("/") or "/"
            if path in ("/", "/index.html"):
                self._send_html(_load_web_html())
                return
            if path in ("/spec/styles/tokens.css", "/spec/styles/palette.css"):
                self._send_static(ROOT / path.lstrip("/"), "text/css; charset=utf-8")
                return
            if path == "/api/snapshot":
                self._send_json({"ok": True, "data": op_snapshot()})
                return
            if path.startswith("/api/health/"):
                name = path[len("/api/health/"):]
                self._send_json({"ok": True, "data": op_health(name)})
                return
            if path.startswith("/api/logs/"):
                name = path[len("/api/logs/"):]
                q = parse_qs(u.query)
                n = 200
                try:
                    n = max(10, min(2000, int(q.get("n", ["200"])[0])))
                except ValueError:
                    pass
                self._send_json({"ok": True, "data": {
                    "name": name, "n": n, "content": op_logs(name, n),
                }})
                return
            self._send_json({"ok": False, "msg": "not found"}, 404)

        def do_POST(self):
            u = urlparse(self.path)
            path = u.path.rstrip("/") or "/"
            body = self._read_body()
            if path.startswith("/api/start/"):
                self._send_json({"ok": True, "result": op_start(path[len("/api/start/"):])})
                return
            if path.startswith("/api/stop/"):
                self._send_json({"ok": True, "result": op_stop(path[len("/api/stop/"):])})
                return
            if path.startswith("/api/stop-external/"):
                self._send_json({"ok": True, "result": op_stop_external(path[len("/api/stop-external/"):])})
                return
            if path.startswith("/api/restart/"):
                name = path[len("/api/restart/"):]
                op_stop(name)
                res = op_start(name)
                self._send_json({"ok": True, "result": res})
                return
            if path.startswith("/api/clear-log/"):
                name = path[len("/api/clear-log/"):]
                self._send_json({"ok": True, "result": op_clear_log(name)})
                return
            if path == "/api/switch":
                target = str(body.get("backend", "")).strip()
                self._send_json({"ok": True, "result": op_switch(target)})
                return
            if path == "/api/db-driver":
                drv = str(body.get("driver", "")).strip()
                self._send_json({"ok": True, "result": op_set_db_driver(drv)})
                return
            if path == "/api/db-config":
                self._send_json({"ok": True, "result": op_set_db_config(body)})
                return
            if path == "/api/llm-config":
                self._send_json({"ok": True, "result": op_set_llm_config(body)})
                return
            if path == "/api/restart-all":
                state = State.load()
                sweep_dead(state)
                names = list(state.processes.keys())
                results = []
                for n in names:
                    results.append({"name": n, **op_stop(n)})
                for n in names:
                    results.append({"name": n, **op_start(n)})
                self._send_json({"ok": True, "result": {"ok": True, "msg": f"已重启 {len(names)} 个", "results": results}})
                return
            if path == "/api/stop-all":
                state = State.load()
                sweep_dead(state)
                names = list(state.processes.keys())
                results = [{"name": n, **op_stop(n)} for n in names]
                self._send_json({"ok": True, "result": {"ok": True, "msg": f"已停止 {len(names)} 个", "results": results}})
                return
            self._send_json({"ok": False, "msg": "not found"}, 404)

    print(bold("\nHelloTime Pro · Web UI"))
    print(f"  监听: {cyan(f'http://{host}:{port}')}")
    print(dim("  按 Ctrl+C 退出\n"))
    if not getattr(args, "no_open", False):
        try:
            import webbrowser
            webbrowser.open(f"http://{host}:{port}")
        except Exception:
            pass
    try:
        ThreadingHTTPServer((host, port), Handler).serve_forever()
    except KeyboardInterrupt:
        print(dim("\n已退出。"))
        return 0
    except OSError as e:
        print(red(f"启动失败: {e}"))
        if "Address already in use" in str(e):
            print(dim(f"  端口 {port} 被占用，可用 --port 指定其他端口"))
        return 7
    return 0

# --------------------------------------------------------------
# 入口
# --------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hello",
        description="HelloTime Pro · dev-manager",
    )
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("list",        help="列出所有已登记实现").set_defaults(func=cmd_list)
    sub.add_parser("doctor",      help="检查环境依赖").set_defaults(func=cmd_doctor)
    sub.add_parser("status",      help="显示进程状态").set_defaults(func=cmd_status)

    start = sub.add_parser("start", help="启动一个或多个实现"); start.add_argument("names", nargs="+")
    start.set_defaults(func=cmd_start)

    stop = sub.add_parser("stop",   help="停止一个或多个 hello 管理的实现"); stop.add_argument("names", nargs="+")
    stop.set_defaults(func=cmd_stop)

    stop_ext = sub.add_parser("stop-external", help="按端口停止外部启动的实现")
    stop_ext.add_argument("names", nargs="+")
    stop_ext.set_defaults(func=cmd_stop_external)

    sub.add_parser("restart-all", help="重启所有").set_defaults(func=cmd_restart_all)

    sw = sub.add_parser("switch",  help="切换 :9080 代理目标后端")
    sw.add_argument("backend")
    sw.set_defaults(func=cmd_switch)

    lg = sub.add_parser("logs",    help="查看尾部日志")
    lg.add_argument("name")
    lg.add_argument("-n", type=int, default=200, help="行数，默认 200")
    lg.set_defaults(func=cmd_logs)

    web = sub.add_parser("web", help="启动 Web UI 控制台")
    web.add_argument("--host", default="127.0.0.1")
    web.add_argument("--port", type=int, default=WEBUI_PORT)
    web.add_argument("--no-open", action="store_true", help="不自动打开浏览器")
    web.set_defaults(func=cmd_web)
    return p

def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        return cmd_web(args)
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
